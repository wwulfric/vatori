#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

TRACE_INSPECTOR_POM="$ROOT/test-support/vaadin-desktop-trace-inspector/pom.xml"
mvn -q -o -Dmaven.repo.local="$ROOT/.m2/repository" \
  -f "$TRACE_INSPECTOR_POM" \
  -DskipTests compile

trace_file=""
trace_gates=""
trace_help="0"
for argument in "$@"; do
  case "$argument" in
    --help)
      trace_help="1"
      ;;
    --require-flow-ipc-standard-bundle-runtime|\
    --require-flow-ipc-vite-development-runtime|\
    --require-flow-ipc-java-reload-development|\
    --require-flow-ipc-reactor-reload-development|\
    --require-flow-ipc-java-reload-rollback-development|\
    --require-flow-ipc-standard-bundle-framework-app|\
    --require-flow-ipc-capability-permission|\
    --require-flow-ipc-capability-default-deny|\
    --require-flow-ipc-capability-manifest-startup-failure|\
    --require-flow-ipc-capability-generation-recovery|\
    --require-flow-ipc-capability-owner-window-close|\
    --require-flow-ipc-capability-context-reopen|\
    --require-flow-ipc-retired-scope-production-host|\
    --require-flow-ipc-file-dialog-outcomes|\
    --require-flow-ipc-file-read-grant|\
    --require-flow-ipc-file-read-grant-sidecar-exit|\
    --require-flow-ipc-file-read-grant-host-shutdown|\
    --require-flow-ipc-file-read-grant-fatal-shutdown|\
    --require-flow-ipc-file-read-grant-isolation|\
    --require-flow-ipc-file-read-grant-replay|\
    --require-flow-ipc-file-read-grant-range|\
    --require-flow-ipc-sandbox-file-read-grant|\
    --require-flow-ipc-sandbox-file-write-grant|\
    --require-flow-ipc-sandbox-file-write-grant-cancel|\
    --require-flow-ipc-sandbox-file-write-grant-owner-close|\
    --require-flow-ipc-sandbox-file-write-grant-isolation|\
    --require-flow-ipc-sandbox-file-write-grant-sidecar-exit|\
    --require-flow-ipc-sandbox-file-write-grant-host-shutdown|\
    --require-flow-ipc-sandbox-file-write-grant-replay|\
    --require-flow-ipc-clipboard-outcomes|\
    --require-flow-ipc-notification-outcomes|\
    --require-flow-ipc-notification-delivery|\
    --require-flow-ipc-main-window-close-recovery|\
    --require-flow-ipc-last-window-close|\
    --require-flow-ipc-lazy-grid-query|\
    --require-flow-ipc-lazy-grid-selected-removal|\
    --require-flow-ipc-lazy-multi-select-combo-box|\
    --require-flow-ipc-multi-select-combo-box|\
    --require-flow-ipc-push-delivery|\
    --require-flow-ipc-push-recovery|\
    --require-flow-ipc-large-download-resume|\
    --require-flow-ipc-large-upload-retry|\
    --require-flow-ipc-in-flight-request-recovery|\
    --require-flow-ipc-large-multipart-upload-retry|\
    --require-flow-ipc-concurrent-upload|\
    --require-flow-ipc-request-fanout|\
    --require-flow-ipc-concurrent-multipart-upload|\
    --require-flow-ipc-cross-session-multipart-upload|\
    --require-flow-ipc-flow-dnd|\
    --require-flow-ipc-flow-input-popup|\
    --require-flow-ipc-localized-input-popup|\
    --require-flow-ipc-localized-number|\
    --require-flow-ipc-localized-number-validation|\
    --require-flow-ipc-native-edit|\
    --require-flow-ipc-native-clipboard-edit|\
    --require-flow-ipc-native-edit-isolation|\
    --require-flow-ipc-native-edit-reopen|\
    --require-flow-ipc-native-edit-recovery|\
    --require-flow-ipc-external-file-drop|\
    --require-flow-ipc-picker-validation|\
    --require-flow-ipc-flow-menu-popup|\
    --require-flow-ipc-flow-overlay-stack|\
    --require-flow-ipc-structured-rpc|\
    --require-flow-ipc-standard-bundle-sidecar-recovery|\
    --require-flow-ipc-sidecar-recovery-exhaustion|\
    --require-flow-ipc-recovery-termination|\
    --require-flow-ipc-host-shutdown-termination|\
    --require-flow-ipc-sidecar-write-backpressure|\
    --require-flow-ipc-host-startup-failure|\
    --require-flow-ipc-host-ready-timeout|\
    --require-flow-ipc-host-navigation-timeout)
      if [[ -n "$trace_gates" ]]; then
        trace_gates+=","
      fi
      trace_gates+="$argument"
      ;;
    --*)
      echo "Unknown option: $argument" >&2
      exit 2
      ;;
    *)
      if [[ -n "$trace_file" ]]; then
        echo "Only one trace file may be inspected at a time." >&2
        exit 2
      fi
      trace_file="$argument"
      ;;
  esac
done

export VATORI_TRACE_INSPECT_FILE="$trace_file"
export VATORI_TRACE_INSPECT_GATES="$trace_gates"
export VATORI_TRACE_INSPECT_HELP="$trace_help"

exec mvn -q -o -Dmaven.repo.local="$ROOT/.m2/repository" \
  -f "$TRACE_INSPECTOR_POM" \
  -Dexec.mainClass=dev.vatori.desktop.testsupport.trace.StandardBundleTraceInspector \
  -Dexec.classpathScope=runtime \
  org.codehaus.mojo:exec-maven-plugin:3.6.2:java
