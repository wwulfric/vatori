#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BUILD_DIR="$ROOT/.build/test-support/native-host-config-resource-smoke"
MODULE_CACHE="$ROOT/.build/clang-module-cache"
mkdir -p "$BUILD_DIR" "$MODULE_CACHE"
CLANG_MODULE_CACHE_PATH="$MODULE_CACHE" /usr/bin/swiftc \
  "$ROOT/native-hosts/macos/Sources/VaadinDesktopHost/SidecarProtocol.swift" \
  "$ROOT/native-hosts/macos/Sources/VaadinDesktopHost/CapabilityManifest.swift" \
  "$ROOT/native-hosts/macos/Sources/VaadinDesktopHost/HostConfig.swift" \
  "$ROOT/native-hosts/macos/Sources/VaadinDesktopHost/JavaSidecarLaunchPlan.swift" \
  "$ROOT/test-support/native-host-macos-acceptance/Tests/native-host-config-resource-smoke.swift" \
  -o "$BUILD_DIR/smoke"
"$BUILD_DIR/smoke"
