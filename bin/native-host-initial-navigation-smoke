#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BUILD_DIR="$ROOT/.build/test-support/native-host-initial-navigation-smoke"
MODULE_CACHE="$ROOT/.build/clang-module-cache"
EXECUTABLE="$BUILD_DIR/native-host-initial-navigation-smoke"

mkdir -p "$BUILD_DIR" "$MODULE_CACHE"
CLANG_MODULE_CACHE_PATH="$MODULE_CACHE" /usr/bin/swiftc \
  "$ROOT/test-support/native-host-macos-acceptance/Sources/VaadinDesktopHostAcceptanceSupport/FlowIpcInitialNavigationWatchdog.swift" \
  "$ROOT/test-support/native-host-macos-acceptance/Tests/flow-ipc-initial-navigation-smoke.swift" \
  -o "$EXECUTABLE"
"$EXECUTABLE"
