#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BUILD_DIR="$ROOT/.build/test-support/native-host-retired-scope-smoke"
MODULE_CACHE="$ROOT/.build/clang-module-cache"
EXECUTABLE="$BUILD_DIR/native-host-retired-scope-smoke"

mkdir -p "$BUILD_DIR" "$MODULE_CACHE"

CLANG_MODULE_CACHE_PATH="$MODULE_CACHE" /usr/bin/swiftc \
  "$ROOT/native-hosts/macos/Sources/VaadinDesktopHost/FlowIpcRetiredScopeRegistry.swift" \
  "$ROOT/test-support/native-host-macos-acceptance/Tests/flow-ipc-retired-scope-smoke.swift" \
  -o "$EXECUTABLE"

"$EXECUTABLE"
