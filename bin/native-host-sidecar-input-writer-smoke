#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BUILD_DIR="$ROOT/.build/test-support/native-host-sidecar-input-writer-smoke"
MODULE_CACHE="$ROOT/.build/clang-module-cache"
EXECUTABLE="$BUILD_DIR/native-host-sidecar-input-writer-smoke"

mkdir -p "$BUILD_DIR" "$MODULE_CACHE"
CLANG_MODULE_CACHE_PATH="$MODULE_CACHE" /usr/bin/swiftc \
  "$ROOT/native-hosts/macos/Sources/VaadinDesktopHost/NativeSidecarInputWriter.swift" \
  "$ROOT/test-support/native-host-macos-acceptance/Tests/native-sidecar-input-writer-smoke.swift" \
  -o "$EXECUTABLE"
"$EXECUTABLE"
