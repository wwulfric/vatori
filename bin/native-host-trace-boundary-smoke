#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BUILD_DIR="$ROOT/.build/test-support/native-host-trace-boundary-smoke"
MODULE_CACHE="$ROOT/.build/clang-module-cache"
EXECUTABLE="$BUILD_DIR/native-host-trace-boundary-smoke"

mkdir -p "$BUILD_DIR" "$MODULE_CACHE"

CLANG_MODULE_CACHE_PATH="$MODULE_CACHE" /usr/bin/swiftc \
  "$ROOT/native-hosts/macos/Sources/VaadinDesktopHost/SidecarProtocol.swift" \
  "$ROOT/native-hosts/macos/Sources/VaadinDesktopHost/TraceCompaction.swift" \
  "$ROOT/native-hosts/macos/Sources/VaadinDesktopHost/TraceRedaction.swift" \
  "$ROOT/test-support/native-host-macos-acceptance/Tests/native-host-trace-boundary-smoke.swift" \
  -o "$EXECUTABLE"

"$EXECUTABLE"
