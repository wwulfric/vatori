#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MAVEN_REPO="${MAVEN_REPO:-$ROOT/.m2/repository}"


if ! command -v mvn >/dev/null 2>&1; then
  echo "Maven 3.9+ is required. Add mvn to PATH." >&2
  exit 1
fi

mvn -o -Dmaven.repo.local="$MAVEN_REPO" -pl vaadin-desktop-flow -am -DskipTests test-compile
mvn -q -o -Dmaven.repo.local="$MAVEN_REPO" \
  -pl vaadin-desktop-flow \
  -Dexec.mainClass=dev.vatori.desktop.flow.transport.OpaqueHttpAdapterSmokeMain \
  -Dexec.classpathScope=test \
  org.codehaus.mojo:exec-maven-plugin:3.6.2:java
