#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

MAX_TRACKED_FILE_BYTES="${MAX_TRACKED_FILE_BYTES:-10485760}"
failed=0

fail() {
  printf 'repository hygiene violation: %s\n' "$*" >&2
  failed=1
}

check_forbidden_path() {
  local path="$1"
  case "$path" in
    .build/*|\
    .m2/*|\
    .DS_Store|\
    */.DS_Store|\
    docs/goal-*.md|\
    docs/archive/goals/*|\
    */target/*|\
    target/*|\
    */node_modules/*|\
    node_modules/*|\
    vaadin-desktop-host-tauri/*|\
    docs/traces/*|\
    assets/brand/vatori.iconset/*|\
    assets/brand/vatori-wordmark.svg.png|\
    */src/main/frontend/generated/*|\
    */src/main/frontend/index.html|\
    */src/main/bundles/*|\
    */vite.generated.ts|\
    *.class|\
    *.jar|\
    *.war|\
    *.ear|\
    *.zip|\
    *.tar|\
    *.tar.gz|\
    *.tgz|\
    *.dmg|\
    *.pkg|\
    *.app/*|\
    *.log)
      fail "tracked generated or packaged artifact: $path"
      ;;
  esac
}

check_size() {
  local path="$1"
  if [[ ! -f "$path" ]]; then
    return 0
  fi
  local bytes
  bytes="$(wc -c < "$path" | tr -d '[:space:]')"
  if [[ "$bytes" =~ ^[0-9]+$ ]] && (( bytes > MAX_TRACKED_FILE_BYTES )); then
    fail "tracked file exceeds $MAX_TRACKED_FILE_BYTES bytes: $path ($bytes bytes)"
  fi
}

check_top_level_docs() {
  local docs=(AGENTS.md README.md README.zh-CN.md)
  local path pattern

  for path in "${docs[@]}"; do
    [[ -f "$path" ]] || continue

    if grep -En '^(<<<<<<<|=======|>>>>>>>)' "$path" >/dev/null; then
      fail "top-level doc contains merge conflict markers: $path"
    fi

    if grep -Ein 'kiss|skill store|/kiss|\$kiss|docs/kiss' "$path" >/dev/null; then
      fail "top-level doc contains unrelated KISS/skill-store content: $path"
    fi

    for pattern in \
      'v1''\.[0-9]' \
      'v1''_[0-9]' \
      'goal-[0-9]' \
      'Goal [0-9]' \
      '--require-flow-ipc-''v1''_[0-9]' \
      'FLOW_IPC_FRONTEND_BUILD_(MAVEN_)?GOAL'
    do
      if grep -En -- "$pattern" "$path" >/dev/null; then
        fail "top-level doc contains implementation batch or trace-gate detail: $path ($pattern)"
      fi
    done
  done
}

check_docs_no_versioned_residue() {
  local paths=(
    AGENTS.md
    README.md
    README.zh-CN.md
    docs/*.md
    test-apps/README.md
    test-apps/flow-over-ipc-smoke-app/README.md
    test-apps/flow-over-ipc-framework-app/README.md
    native-hosts/macos/README.md
    test-support/README.md
    test-support/native-host-macos-acceptance/README.md
    test-support/vaadin-desktop-trace-inspector/README.md
  )
  local path pattern

  for path in "${paths[@]}"; do
    [[ -f "$path" ]] || continue
    for pattern in \
      'v1''\.[0-9]' \
      'v1''_[0-9]' \
      'V1''_[0-9]' \
      'FLOW_IPC_''V1' \
      '--require-flow-ipc-''v1' \
      'Flow IPC message ''v' \
      'Slice[0-9]' \
      'slice[0-9]' \
      'goal-[0-9]' \
      'goal_[0-9]' \
      'VAADIN_DESKTOP_FLOW_IPC_LEGACY_SHELL' \
      'FlowIpcShell' \
      'vaadin-desktop-flow-test-support'
    do
      if grep -En -- "$pattern" "$path" >/dev/null; then
        fail "doc contains versioned implementation residue: $path ($pattern)"
      fi
    done
  done
}

check_trace_inspector_contract() {
  local wrapper="bin/flow-ipc-trace-inspect"
  local module="test-support/vaadin-desktop-trace-inspector"
  local main_source="$module/src/main/java/dev/vatori/desktop/testsupport/trace"
  local test_source="$module/src/test/java/dev/vatori/desktop/testsupport/trace"
  [[ -f "$wrapper" ]] || return 0

  if ! grep -Fq 'StandardBundleTraceInspector' "$wrapper"; then
    fail "trace inspector wrapper must use the standard-bundle inspector"
  fi
  if grep -Fq 'DesktopTraceInspector' "$wrapper"; then
    fail "trace inspector wrapper still selects the historical gate system"
  fi

  local unexpected_source
  unexpected_source="$(find "$main_source" -type f ! -name 'StandardBundleTraceInspector.java' -print -quit)"
  if [[ -n "$unexpected_source" ]]; then
    fail "historical trace inspector source returned: $unexpected_source"
  fi
  unexpected_source="$(find "$test_source" -type f ! -name 'StandardBundleTraceInspectorSmokeMain.java' -print -quit)"
  if [[ -n "$unexpected_source" ]]; then
    fail "historical trace inspector test returned: $unexpected_source"
  fi
  if [[ ! -f "$main_source/StandardBundleTraceInspector.java" \
      || ! -f "$test_source/StandardBundleTraceInspectorSmokeMain.java" ]]; then
    fail "standard-bundle trace inspector source or smoke is missing"
  fi
  if grep -Fq '<artifactId>vaadin-desktop-ipc</artifactId>' "$module/pom.xml"; then
    fail "standalone trace inspector must not depend on the framework IPC module"
  fi
  if grep -Fq '<module>test-support/' pom.xml; then
    fail "repository-only test support must not be part of the framework reactor"
  fi

  local retired_smoke
  for retired_smoke in \
    uidl-adapter-smoke \
    uidl-rpc-smoke \
    flow-client-resource-smoke \
    flow-ipc-renderer-smoke
  do
    if grep -Fq "$retired_smoke" bin/verify-smoke; then
      fail "verify-smoke still invokes retired typed-shell check: $retired_smoke"
    fi
  done
}

check_retired_flow_ipc_scaffolding() {
  local retired_path
  for retired_path in \
    vaadin-desktop-flow-test-support \
    test-support/native-host-macos-acceptance/Resources/FlowIpcShell \
    test-support/native-host-macos-acceptance/Resources/FlowIpcShell.html \
    test-support/native-host-macos-acceptance/Resources/FlowIpcShell.css
  do
    if [[ -e "$retired_path" ]]; then
      fail "retired Flow IPC scaffolding returned: $retired_path"
    fi
  done
}

check_macos_host_launcher_contract() {
  local host_config="native-hosts/macos/Sources/VaadinDesktopHost/HostConfig.swift"
  local acceptance_config="test-support/native-host-macos-acceptance/Sources/VaadinDesktopHostAcceptanceSupport/FlowIpcAutomationFlags.swift"
  local production_launcher="bin/vaadin-desktop-macos-host-launch"
  local acceptance_runner="test-support/native-host-macos-acceptance/bin/run"
  local missing=()
  local token

  [[ -f "$host_config" && -f "$production_launcher" \
      && -f "$acceptance_config" && -f "$acceptance_runner" ]] || return 0

  while IFS= read -r token; do
    [[ -n "$token" ]] || continue
    if ! grep -Fq -- "$token" "$production_launcher"; then
      missing+=("$token")
    fi
  done < <(
    grep -Eoh 'environment\["VAADIN_DESKTOP_[A-Z0-9_]+"\]' "$host_config" \
      | sed -E 's/.*"([^"]+)".*/\1/' \
      | sort -u
  )

  while IFS= read -r token; do
    [[ -n "$token" ]] || continue
    if ! grep -Fq -- "$token" "$acceptance_runner"; then
      missing+=("$token")
    fi
  done < <(
    grep -Eoh '"VAADIN_DESKTOP_FLOW_IPC_AUTO_[A-Z0-9_]+"' "$acceptance_config" \
      | tr -d '"' \
      | sort -u
  )

  if (( ${#missing[@]} > 0 )); then
    fail "macOS host environment token is not represented by its launcher: ${missing[*]}"
  fi

  local production_boundary_match
  production_boundary_match="$(rg -n -m 1 \
    -e 'test-support/native-host-macos-acceptance' \
    -e 'VAADIN_DESKTOP_FLOW_IPC_AUTO_' \
    -e 'VAADIN_DESKTOP_FLOW_IPC_ACCEPTANCE' \
    bin/vaadin-desktop \
    bin/vaadin-desktop-build-macos-host \
    bin/vaadin-desktop-macos-host-launch || true)"
  if [[ -n "$production_boundary_match" ]]; then
    fail "production macOS build/launch path knows acceptance support: $production_boundary_match"
  fi
}

check_framework_test_boundaries() {
  local production_roots=(
    vaadin-desktop-core/src/main
    vaadin-desktop-ipc/src/main
    vaadin-desktop-flow/src/main
    vaadin-desktop-spring-boot/src/main
    vaadin-desktop-cli/src/main
    native-hosts/macos/Sources/VaadinDesktopHost
    native-hosts/macos/Resources
  )
  local pattern match

  for pattern in \
    'test-apps/flow-over-ipc' \
    'strict-smoke-app|framework-validation-app' \
    'FlowIpc(ComponentMatrix|DynamicResource)Attributes' \
    'owner-(runtime|dependency)-positive-fixture' \
    'generated-flow-imports-chunk-fixture|chunk-fixture\.js' \
    'vatori-flow-ipc-smoke|FlowIpcGeneratedLazyProbeView|dev\.vatori\.ipcsmoke' \
    'examples/|test-apps/|test-support/' \
    'VAADIN_DESKTOP_FLOW_IPC_AUTO_' \
    'VATORI_FLOW_IPC_ACCEPTANCE|Acceptance|acceptance|ForTest|testPath|controlled-test-path|FixtureSubstituted' \
    '(broaderComponentResource|dataComponentResource|inputComponentParity|multiValueNavigationDisclosure|overlayContextMenu|contentAppShellLogin|richTextEditor[A-Za-z0-9]*)Matrix' \
    'uidlTraceSearchIndex|uidlSearchIndex|componentProductionOwner|uploadReceiver|uploadMultipart|downloadHandlerSaveOpen' \
    'compactWebViewDomTracePayload|optional(ResourceLoad|Dom|Envelope)TracePrefixes'
  do
    match="$(rg -n -m 1 -e "$pattern" "${production_roots[@]}" || true)"
    if [[ -n "$match" ]]; then
      fail "acceptance fixture leaked into production source: $match"
    fi
  done

  local trace_semantic_match
  trace_semantic_match="$(rg -n -m 1 \
    -e 'flowClientResources' \
    -e 'componentFrontendResources' \
    -e 'envelopePayload\["uidl"\]' \
    -e 'case "opaque(Http|Push)' \
    native-hosts/macos/Sources/VaadinDesktopHost/TraceCompaction.swift || true)"
  if [[ -n "$trace_semantic_match" ]]; then
    fail "native host trace compaction interprets Flow payload semantics: $trace_semantic_match"
  fi

  local legacy_flow_runtime_source
  legacy_flow_runtime_source="$(find vaadin-desktop-flow/src/main/java/dev/vatori/desktop/flow \
    -type f \( \
      -name 'FlowClientResources.java' -o \
      -name 'FlowIpcRuntime.java' -o \
      -name 'FlowIpcRenderer.java' -o \
      -name 'FlowIpcRuntimeContributor*.java' -o \
      -name 'FlowIpc*Attributes.java' -o \
      -name 'FlowIpc*Evidence.java' -o \
      -name 'FlowIpcFrontendBuildEnvironment.java' -o \
      -name 'FlowIpcBuildOutputScanner.java' -o \
      -name 'FlowIpcClasspathResources.java' -o \
      -name 'FlowIpcDiagnostics.java' -o \
      -name 'FlowIpcJavaScriptModuleGraph.java' -o \
      -name 'GeneratedLoadOnDemandChunkFileRegistry.java' -o \
      -name 'LegacyFlowResourceAdapter.java' -o \
      -name 'DesktopFlowRuntimeSession.java' -o \
      -name 'FlowClientMessage.java' -o \
      -name 'FlowPatchResponse.java' -o \
      -name 'FlowTransportAdapter.java' -o \
      -name 'UidlFlowTransportAdapter.java' \
    \) -print -quit)"
  if [[ -n "$legacy_flow_runtime_source" ]]; then
    fail "legacy typed Flow runtime must not exist in production source: $legacy_flow_runtime_source"
  fi

  local forbidden_resource
  for forbidden_resource in \
    native-hosts/macos/Sources/VaadinDesktopHostAcceptanceSupport \
    native-hosts/macos/Sources/VaadinDesktopHost/FlowIpcShell.swift \
    native-hosts/macos/Sources/VaadinDesktopHost/FlowIpcRuntimeInspectionScript.swift \
    native-hosts/macos/Sources/VaadinDesktopHost/WebViewDiagnostics.swift \
    native-hosts/macos/Resources/FlowIpcShell.html \
    native-hosts/macos/Resources/FlowIpcShell.css \
    native-hosts/macos/Resources/FlowIpcShell \
    native-hosts/macos/Resources/FlowIpcShell/Acceptance \
    vaadin-desktop-flow/src/main/resources/META-INF/vatori/generated/flow/generated-flow-imports-chunk-fixture.js \
    vaadin-desktop-flow/src/main/resources/META-INF/vatori/generated/flow/chunks/chunk-fixture.js \
    vaadin-desktop-flow/src/main/resources/META-INF/vatori/production-owner/owner-runtime-positive-fixture.js \
    vaadin-desktop-flow/src/main/resources/META-INF/vatori/production-owner/owner-dependency-positive-fixture.js
  do
    if [[ -e "$forbidden_resource" ]]; then
      case "$forbidden_resource" in
        native-hosts/macos/*)
          fail "macOS host acceptance support belongs in test-support/native-host-macos-acceptance: $forbidden_resource"
          ;;
        *)
          fail "obsolete Flow IPC fixture remains in production resources: $forbidden_resource"
          ;;
      esac
    fi
  done

  local dependency_owner
  while IFS= read -r dependency_owner; do
    case "$dependency_owner" in
      pom.xml|\
      vaadin-desktop-flow-test-support/pom.xml)
        ;;
      *)
        fail "framework or example depends on validation-only test support: $dependency_owner"
        ;;
    esac
  done < <(rg -l 'vaadin-desktop-flow-test-support' --glob 'pom.xml' . | sed 's#^\./##')

  if [[ -d vaadin-desktop-devtools ]] \
      && find vaadin-desktop-devtools -type f \
        -not -path '*/target/*' -print -quit | grep -q .; then
    fail "repository-only trace inspector must live under test-support"
  fi
}

check_single_native_host_contract() {
  local retired_path
  for retired_path in \
    vaadin-desktop-host \
    vaadin-desktop-host-swift \
    test-support/vaadin-desktop-host-swift-acceptance \
    bin/vaadin-desktop-build-swift-host \
    bin/vaadin-desktop-swift-host-launch
  do
    if [[ -e "$retired_path" ]]; then
      fail "retired host path returned: $retired_path"
    fi
  done

  local search_roots=(
    AGENTS.md
    README.md
    README.zh-CN.md
    docs
    bin
    native-hosts
    test-support
    vaadin-desktop-core
    vaadin-desktop-ipc
    vaadin-desktop-flow
    vaadin-desktop-spring-boot
    vaadin-desktop-cli
    test-apps
    examples
    pom.xml
  )
  local pattern match
  for pattern in \
    'VDP1 ' \
    'Application URL:' \
    'VAADIN_DESKTOP_HOST[A-Z0-9_]*' \
    'VAADIN_DESKTOP_NATIVE_BRIDGE' \
    'VAADIN_DESKTOP_FLOW_IPC_STANDARD_BUNDLE' \
    '\b(dev-ipc|run-ipc|dev-swift|run-swift|dev-native|run-native)\b' \
    'FlowIpcLauncher' \
    'HostProtocolNativeBridge'
  do
    match="$(rg -n -m 1 --glob '!repository-hygiene-check' \
      -e "$pattern" "${search_roots[@]}" || true)"
    if [[ -n "$match" ]]; then
      fail "retired host contract returned: $match"
    fi
  done

  if grep -Fq '<module>vaadin-desktop-host</module>' pom.xml; then
    fail "retired Java host module returned to the Maven reactor"
  fi
  if rg -l '<artifactId>vaadin-desktop-host</artifactId>' --glob 'pom.xml' . >/dev/null; then
    fail "a Maven module depends on the retired Java host artifact"
  fi
}

check_runtime_boundary_contract() {
  local match
  match="$(rg -n -m 1 --glob '!repository-hygiene-check' \
    -e 'VFIPC1' -e 'flow-ipc-v1' \
    AGENTS.md README.md README.zh-CN.md docs bin native-hosts test-support \
    vaadin-desktop-core vaadin-desktop-ipc vaadin-desktop-flow \
    vaadin-desktop-spring-boot vaadin-desktop-cli examples test-apps || true)"
  if [[ -n "$match" ]]; then
    fail "retired sidecar protocol version encoding returned: $match"
  fi

  match="$(rg -n -m 1 \
    -e 'DesktopMenu' -e 'menu\.setApplicationMenu' \
    vaadin-desktop-core vaadin-desktop-flow vaadin-desktop-spring-boot \
    native-hosts examples test-apps || true)"
  if [[ -n "$match" ]]; then
    fail "unimplemented desktop menu API returned: $match"
  fi

  match="$(rg -n -m 1 \
    -e 'org\.springframework' -e 'com\.vaadin\.flow\.spring' \
    vaadin-desktop-flow/src examples test-apps/flow-over-ipc-smoke-app \
    test-apps/flow-over-ipc-framework-app || true)"
  if [[ -n "$match" ]]; then
    fail "Spring leaked into the pure Flow runtime or application: $match"
  fi
  match="$(rg -n -m 1 '<artifactId>vaadin-dev</artifactId>' \
    examples test-apps/flow-over-ipc-smoke-app \
    test-apps/flow-over-ipc-framework-app || true)"
  if [[ -n "$match" ]]; then
    fail "vaadin-dev leaked Spring/Copilot dependencies into a pure Flow app: $match"
  fi

  match="$(rg -n -m 1 \
    -e 'pom\.xml' -e 'spring-boot:run' -e 'mavenExecutable' \
    -e 'mavenRepo' -e 'repoRoot' -e 'config\.module' \
    -e 'VAADIN_DESKTOP_MODULE' -e 'VAADIN_DESKTOP_REPO_ROOT' \
    native-hosts/macos/Sources native-hosts/macos/Resources || true)"
  if [[ -n "$match" ]]; then
    fail "macOS host understands repository or Maven build state: $match"
  fi

  if ! grep -Fq 'ProcessBuilder' \
      vaadin-desktop-cli/src/main/java/dev/vatori/desktop/cli/VaadinDesktopCli.java; then
    fail "Java CLI no longer owns build and platform process orchestration"
  fi
  if ! grep -Fq 'Sidecar/application.jar' bin/vaadin-desktop-build-macos-host \
      || ! grep -Fq 'VatoriHost.json' bin/vaadin-desktop-build-macos-host; then
    fail "macOS builder no longer stages the sidecar JAR and launch manifest"
  fi
  if ! grep -Fq 'vatori-icon.icns' bin/vaadin-desktop-build-macos-host \
      || ! grep -Fq 'AppIcon.icns' bin/vaadin-desktop-build-macos-host \
      || ! grep -Fq 'CFBundleIconFile' bin/vaadin-desktop-build-macos-host; then
    fail "macOS builder no longer stages the application icon with a vatori fallback"
  fi
  if ! grep -Fq 'ApplicationBundleInputs.discover' \
      vaadin-desktop-cli/src/main/java/dev/vatori/desktop/cli/VaadinDesktopCli.java \
      || ! grep -Fq 'applicationResources' bin/vaadin-desktop-build-macos-host \
      || ! grep -Fq 'VATORI_APPLICATION_RESOURCES' \
      native-hosts/macos/Sources/VaadinDesktopHost/JavaSidecar.swift; then
    fail "application-owned desktop bundle resources are no longer staged end to end"
  fi
  if grep -Eq -- '--(module|repo-root|maven-repo|maven-executable)' \
      bin/vaadin-desktop-macos-host-launch; then
    fail "macOS launcher passes repository/build arguments to Swift"
  fi
  if [[ -e bin/vaadin-desktop-build-flow-bundle ]]; then
    fail "shell frontend builder returned; Java CLI must own the production bundle"
  fi
  if ! grep -Fq 'bin/vaadin-desktop" package' \
      test-support/native-host-macos-acceptance/bin/run; then
    fail "native-host acceptance no longer reuses the Java CLI build boundary"
  fi
}

while IFS= read -r -d '' path; do
  if [[ ! -e "$path" ]]; then
    continue
  fi
  check_forbidden_path "$path"
  check_size "$path"
done < <(git ls-files -z)

check_top_level_docs
check_docs_no_versioned_residue
check_macos_host_launcher_contract
check_framework_test_boundaries
check_trace_inspector_contract
check_retired_flow_ipc_scaffolding
check_single_native_host_contract
check_runtime_boundary_contract

if (( failed )); then
  exit 1
fi

echo "Repository hygiene check passed."
