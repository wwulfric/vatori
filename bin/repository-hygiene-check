#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

MAX_TRACKED_FILE_BYTES="${MAX_TRACKED_FILE_BYTES:-10485760}"
failed=0

fail() {
  printf 'repository hygiene violation: %s\n' "$*" >&2
  failed=1
}

check_forbidden_path() {
  local path="$1"
  case "$path" in
    .build/*|\
    .m2/*|\
    .DS_Store|\
    */.DS_Store|\
    docs/goal-*.md|\
    docs/archive/goals/*|\
    */target/*|\
    target/*|\
    vaadin-desktop-host-tauri/*|\
    docs/traces/*|\
    assets/brand/vatori.iconset/*|\
    assets/brand/vatori-wordmark.svg.png|\
    */src/main/frontend/generated/*|\
    */src/main/frontend/index.html|\
    */src/main/bundles/*|\
    *.class|\
    *.jar|\
    *.war|\
    *.ear|\
    *.zip|\
    *.tar|\
    *.tar.gz|\
    *.tgz|\
    *.dmg|\
    *.pkg|\
    *.app/*|\
    *.log)
      fail "tracked generated or packaged artifact: $path"
      ;;
  esac
}

check_size() {
  local path="$1"
  if [[ ! -f "$path" ]]; then
    return 0
  fi
  local bytes
  bytes="$(wc -c < "$path" | tr -d '[:space:]')"
  if [[ "$bytes" =~ ^[0-9]+$ ]] && (( bytes > MAX_TRACKED_FILE_BYTES )); then
    fail "tracked file exceeds $MAX_TRACKED_FILE_BYTES bytes: $path ($bytes bytes)"
  fi
}

check_top_level_docs() {
  local docs=(AGENTS.md README.md README.zh-CN.md)
  local path pattern

  for path in "${docs[@]}"; do
    [[ -f "$path" ]] || continue

    if grep -En '^(<<<<<<<|=======|>>>>>>>)' "$path" >/dev/null; then
      fail "top-level doc contains merge conflict markers: $path"
    fi

    if grep -Ein 'kiss|skill store|/kiss|\$kiss|docs/kiss' "$path" >/dev/null; then
      fail "top-level doc contains unrelated KISS/skill-store content: $path"
    fi

    for pattern in \
      'v1\.[0-9]' \
      'v1_[0-9]' \
      'goal-[0-9]' \
      'Goal [0-9]' \
      '--require-flow-ipc-v1_[0-9]' \
      'FLOW_IPC_FRONTEND_BUILD_(MAVEN_)?GOAL'
    do
      if grep -En -- "$pattern" "$path" >/dev/null; then
        fail "top-level doc contains implementation batch or trace-gate detail: $path ($pattern)"
      fi
    done
  done
}

check_swift_host_launcher_contract() {
  local host_config="vaadin-desktop-host-swift/Sources/VaadinDesktopHost/HostConfig.swift"
  local launcher="bin/vaadin-desktop-swift-host-launch"
  local missing=()
  local token

  [[ -f "$host_config" && -f "$launcher" ]] || return 0

  while IFS= read -r token; do
    [[ -n "$token" ]] || continue
    if ! grep -Fq -- "$token" "$launcher"; then
      missing+=("$token")
    fi
  done < <(
    grep -Eoh 'environment\["VAADIN_DESKTOP_[A-Z0-9_]+"\]' "$host_config" \
      | sed -E 's/.*"([^"]+)".*/\1/' \
      | sort -u
  )

  while IFS= read -r token; do
    [[ -n "$token" ]] || continue
    if ! grep -Fq -- "$token" "$launcher"; then
      missing+=("$token")
    fi
  done < <(
    grep -Eoh 'case "--flow-ipc-auto-[^"]+"' "$host_config" \
      | sed -E 's/.*"([^"]+)".*/\1/' \
      | sort -u
  )

  if (( ${#missing[@]} > 0 )); then
    fail "Swift HostConfig env/CLI token is not represented by launcher: ${missing[*]}"
  fi
}

while IFS= read -r -d '' path; do
  if [[ ! -e "$path" ]]; then
    continue
  fi
  check_forbidden_path "$path"
  check_size "$path"
done < <(git ls-files -z)

check_top_level_docs
check_swift_host_launcher_contract

if (( failed )); then
  exit 1
fi

echo "Repository hygiene check passed."
