#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MAVEN_REPO="${MAVEN_REPO:-$ROOT/.m2/repository}"

if ! command -v mvn >/dev/null 2>&1 && [[ -f "$HOME/.sdkman/bin/sdkman-init.sh" ]]; then
  # shellcheck source=/dev/null
  set +u
  source "$HOME/.sdkman/bin/sdkman-init.sh"
  set -u
fi

if ! command -v mvn >/dev/null 2>&1; then
  echo "mvn not found. Install Maven or initialize SDKMAN before running this command." >&2
  exit 1
fi

TRACE_INSPECTOR_POM="$ROOT/test-support/vaadin-desktop-trace-inspector/pom.xml"
mvn -o -Dmaven.repo.local="$MAVEN_REPO" \
  -f "$TRACE_INSPECTOR_POM" \
  -DskipTests install
mvn -q -o -Dmaven.repo.local="$MAVEN_REPO" \
  -f "$TRACE_INSPECTOR_POM" \
  -Dexec.mainClass=dev.vatori.desktop.testsupport.trace.StandardBundleTraceInspectorSmokeMain \
  -Dexec.classpathScope=test \
  org.codehaus.mojo:exec-maven-plugin:3.6.2:java
mvn -q -o -Dmaven.repo.local="$MAVEN_REPO" \
  -f "$TRACE_INSPECTOR_POM" \
  -Dexec.mainClass=dev.vatori.desktop.testsupport.trace.NotificationOutcomesTraceGateSmokeMain \
  -Dexec.classpathScope=test \
  org.codehaus.mojo:exec-maven-plugin:3.6.2:java
mvn -q -o -Dmaven.repo.local="$MAVEN_REPO" \
  -f "$TRACE_INSPECTOR_POM" \
  -Dexec.mainClass=dev.vatori.desktop.testsupport.trace.NotificationDeliveryTraceGateSmokeMain \
  -Dexec.classpathScope=test \
  org.codehaus.mojo:exec-maven-plugin:3.6.2:java
mvn -q -o -Dmaven.repo.local="$MAVEN_REPO" \
  -f "$TRACE_INSPECTOR_POM" \
  -Dexec.mainClass=dev.vatori.desktop.testsupport.trace.RecoveryTerminationTraceGateSmokeMain \
  -Dexec.classpathScope=test \
  org.codehaus.mojo:exec-maven-plugin:3.6.2:java
mvn -q -o -Dmaven.repo.local="$MAVEN_REPO" \
  -f "$TRACE_INSPECTOR_POM" \
  -Dexec.mainClass=dev.vatori.desktop.testsupport.trace.HostShutdownTerminationTraceGateSmokeMain \
  -Dexec.classpathScope=test \
  org.codehaus.mojo:exec-maven-plugin:3.6.2:java
mvn -q -o -Dmaven.repo.local="$MAVEN_REPO" \
  -f "$TRACE_INSPECTOR_POM" \
  -Dexec.mainClass=dev.vatori.desktop.testsupport.trace.SidecarWriteBackpressureTraceGateSmokeMain \
  -Dexec.classpathScope=test \
  org.codehaus.mojo:exec-maven-plugin:3.6.2:java
