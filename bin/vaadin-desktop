#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if ! command -v mvn >/dev/null 2>&1 && [[ -f "$HOME/.sdkman/bin/sdkman-init.sh" ]]; then
  # shellcheck source=/dev/null
  set +u
  source "$HOME/.sdkman/bin/sdkman-init.sh"
  set -u
fi

if ! command -v mvn >/dev/null 2>&1; then
  echo "mvn not found. Install Maven or initialize SDKMAN before running this command." >&2
  exit 1
fi

COMMAND="${1:-help}"
MODULE="${2:-examples/counter-app}"
if [[ "$COMMAND" == "dev-ipc" || "$COMMAND" == "run-ipc" ]] && [[ $# -lt 2 ]]; then
  echo "$COMMAND requires an explicit application module." >&2
  echo "Usage: bin/vaadin-desktop $COMMAND <module>" >&2
  exit 2
fi

if [[ "$COMMAND" == "dev-ipc" || "$COMMAND" == "run-ipc" ]]; then
  export VAADIN_DESKTOP_FLOW_IPC_STANDARD_BUNDLE=1
fi
MAVEN_REPO="${MAVEN_REPO:-$ROOT/.m2/repository}"
MODULE_POM="$ROOT/$MODULE/pom.xml"

ensure_module() {
  if [[ ! -f "$MODULE_POM" ]]; then
    echo "Module not found: $MODULE" >&2
    exit 1
  fi
}

# shellcheck source=/dev/null
source "$ROOT/bin/vaadin-desktop-flow-ipc-preflight"
# shellcheck source=/dev/null
source "$ROOT/bin/vaadin-desktop-swift-host-launch"

install_module_with_dependencies() {
  local maven_mode="-U"
  if [[ "${VAADIN_DESKTOP_MAVEN_OFFLINE:-}" == "1" ]]; then
    maven_mode="-o"
  fi
  mvn "$maven_mode" -Dmaven.repo.local="$MAVEN_REPO" -f "$ROOT/pom.xml" -pl "$MODULE" -am \
    -DskipTests -Dmaven.jar.forceCreation=true install
}


case "$COMMAND" in
  dev|run)
    ensure_module
    install_module_with_dependencies
    exec mvn -U -Dmaven.repo.local="$MAVEN_REPO" -f "$MODULE_POM" spring-boot:run
    ;;
  dev-swift|run-swift|dev-native|run-native|dev-ipc|run-ipc)
    ensure_module
    install_module_with_dependencies
    run_flow_ipc_frontend_build_preflight
    run_swift_host_runtime
    exit "$?"
    ;;
  package)
    ensure_module
    install_module_with_dependencies
    exec mvn -U -Dmaven.repo.local="$MAVEN_REPO" -f "$MODULE_POM" -Pproduction package
    ;;
  help|--help|-h)
    cat <<USAGE
Usage:
  bin/vaadin-desktop dev <module>
  bin/vaadin-desktop dev-swift <module>
  bin/vaadin-desktop dev-ipc <module>
  bin/vaadin-desktop run <module>
  bin/vaadin-desktop package <module>

Examples:
  bin/vaadin-desktop dev examples/counter-app
  bin/vaadin-desktop dev-swift test-apps/vaadin-desktop-smoke-app
  bin/vaadin-desktop dev-ipc examples/counter-app
  bin/vaadin-desktop dev-ipc test-apps/flow-over-ipc-smoke-app
  bin/vaadin-desktop dev-ipc test-apps/flow-over-ipc-framework-app
  bin/vaadin-desktop dev test-apps/vaadin-desktop-smoke-app

dev-ipc always uses the application's standard Vaadin production bundle.
USAGE
    ;;
  *)
    echo "Unknown command: $COMMAND" >&2
    exit 1
    ;;
esac
