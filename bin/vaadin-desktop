#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if ! command -v mvn >/dev/null 2>&1; then
  echo "Maven 3.9+ is required. Add mvn to PATH." >&2
  exit 1
fi

MAVEN_REPO="${MAVEN_REPO:-$ROOT/.m2/repository}"
MAVEN_MODE="-U"
if [[ "${VAADIN_DESKTOP_MAVEN_OFFLINE:-}" == "1" ]]; then
  MAVEN_MODE="-o"
fi

mvn "$MAVEN_MODE" -Dmaven.repo.local="$MAVEN_REPO" \
  -f "$ROOT/pom.xml" -pl vaadin-desktop-cli -am -DskipTests package >/dev/null

exec java -Dvatori.repo.root="$ROOT" \
  -jar "$ROOT/vaadin-desktop-cli/target/vaadin-desktop-cli-0.1.0-SNAPSHOT.jar" "$@"
