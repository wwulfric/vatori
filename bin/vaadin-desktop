#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if ! command -v mvn >/dev/null 2>&1 && [[ -f "$HOME/.sdkman/bin/sdkman-init.sh" ]]; then
  # shellcheck source=/dev/null
  set +u
  source "$HOME/.sdkman/bin/sdkman-init.sh"
  set -u
fi

if ! command -v mvn >/dev/null 2>&1; then
  echo "mvn not found. Install Maven or initialize SDKMAN before running this command." >&2
  exit 1
fi

COMMAND="${1:-help}"
MODULE="${2:-examples/counter-app}"
if [[ "$COMMAND" == "dev-ipc" && $# -lt 2 ]]; then
  MODULE="test-apps/flow-over-ipc-smoke-app"
fi
MAVEN_REPO="${MAVEN_REPO:-$ROOT/.m2/repository}"
MODULE_POM="$ROOT/$MODULE/pom.xml"

ensure_module() {
  if [[ ! -f "$MODULE_POM" ]]; then
    echo "Module not found: $MODULE" >&2
    exit 1
  fi
}

redact_for_trace() {
  local value="$1"
  value="${value//$ROOT/\$REPO}"
  value="${value//$HOME/\$HOME}"
  printf '%s' "$value"
}

single_line_log_summary() {
  local file="$1"
  if [[ ! -f "$file" ]]; then
    return 0
  fi
  tail -n 12 "$file" | tr '\n' ' ' | tr -s ' ' | cut -c 1-1200
}

classify_frontend_build_output_usability() {
  local module_dir="$ROOT/$MODULE"
  local target_dir="$module_dir/target"
  local source_generated_dir="$module_dir/src/main/frontend/generated/flow"
  if [[ ! -d "$target_dir" ]]; then
    if [[ -f "$source_generated_dir/generated-flow-imports.js" ]]; then
      if find "$source_generated_dir/chunks" -type f -name 'chunk-*.js' 2>/dev/null | grep -q .; then
        printf '%s' "source-generated-imports-and-chunk"
      else
        printf '%s' "source-generated-imports-no-chunk"
      fi
      return 0
    fi
    printf '%s' "output-missing"
    return 0
  fi
  if [[ -f "$source_generated_dir/generated-flow-imports.js" ]]; then
    if find "$source_generated_dir/chunks" -type f -name 'chunk-*.js' 2>/dev/null | grep -q .; then
      printf '%s' "source-generated-imports-and-chunk"
    else
      printf '%s' "source-generated-imports-no-chunk"
    fi
    return 0
  fi
  if find "$target_dir" -type f -path '*/chunks/chunk-*.js' 2>/dev/null | grep -q .; then
    printf '%s' "usable-generated-chunk"
    return 0
  fi
  if find "$target_dir/classes/META-INF/VAADIN/webapp/VAADIN/build" -type f -name 'generated-flow-imports*.js' 2>/dev/null | grep -q .; then
    printf '%s' "production-generated-imports-bundled"
    return 0
  fi
  if find "$target_dir" -type f -name 'generated-flow-imports*.js' 2>/dev/null | grep -q .; then
    printf '%s' "generated-imports-no-chunk"
    return 0
  fi
  if [[ -f "$module_dir/src/main/bundles/prod.bundle" ]]; then
    printf '%s' "production-bundle-only"
    return 0
  fi
  if [[ -d "$module_dir/src/main/frontend/generated" ]] \
      || [[ -d "$module_dir/frontend/generated" ]] \
      || [[ -d "$target_dir/frontend/generated" ]]; then
    printf '%s' "prepare-frontend-generated-scaffold-no-generated-imports"
    return 0
  fi
  printf '%s' "output-incomplete"
}

install_module_with_dependencies() {
  local maven_mode="-U"
  if [[ "${VAADIN_DESKTOP_MAVEN_OFFLINE:-}" == "1" ]]; then
    maven_mode="-o"
  fi
  mvn "$maven_mode" -Dmaven.repo.local="$MAVEN_REPO" -f "$ROOT/pom.xml" -pl "$MODULE" -am -DskipTests install
}

run_flow_ipc_frontend_build_preflight() {
  if [[ "$COMMAND" != "dev-ipc" && "$COMMAND" != "run-ipc" ]]; then
    return 0
  fi
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_30=1
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_31=1
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_32=1
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_44=1
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_45=1
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_46=1
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_47=1
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_48=1
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_49=1
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_50=1
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_51=1
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_52=1
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_53=1
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_54=1
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_55=1
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_STEP_STATUS="skipped"
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_STEP_EXIT_CODE="-1"
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_STEP_DURATION_MILLIS="0"
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_OUTPUT_ROOTS="$(redact_for_trace "$MODULE/src/main/frontend/generated,$MODULE/src/main/bundles,$MODULE/target,$MODULE/target/frontend/generated,$MODULE/target/classes/META-INF/VAADIN/webapp/VAADIN/build,$MODULE/target/classes/META-INF/VAADIN/config")"
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_STEP_COMMAND=""
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_STEP_SUMMARY=""
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_STDOUT_LOG=""
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_STDERR_LOG=""
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_AVAILABILITY_MODE="offline-default"
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_EFFECTIVE_MAVEN_MODE="-o"
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_PLUGIN_COORDINATES=""
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_PLUGIN_RESOLUTION_STATUS="not-attempted"
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_GOAL_RESULT="skipped"
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_OUTPUT_USABILITY="not-inspected"
  local requested_goal="${VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_GOAL:-prepare-frontend}"
  if [[ "$requested_goal" != "prepare-frontend" && "$requested_goal" != "build-frontend" ]]; then
    requested_goal="prepare-frontend"
  fi
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_GOAL_NAME="$requested_goal"
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_PRODUCTION_MODE="false"
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_FORCE_PRODUCTION_BUILD="false"
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_IGNORE_VERSION_CHECKS="false"
  if [[ "${VAADIN_DESKTOP_FLOW_IPC_PREPARE_FRONTEND:-}" != "1" ]]; then
    return 0
  fi

  local build_dir="$ROOT/.build/flow-ipc-frontend-build"
  local stdout_log="$build_dir/$requested_goal.out.log"
  local stderr_log="$build_dir/$requested_goal.err.log"
  mkdir -p "$build_dir"
  : > "$stdout_log"
  : > "$stderr_log"

  local vaadin_version="${VAADIN_DESKTOP_VAADIN_VERSION:-}"
  if [[ -z "$vaadin_version" ]]; then
    vaadin_version="$(sed -n 's:.*<vaadin.version>\(.*\)</vaadin.version>.*:\1:p' "$ROOT/pom.xml" | head -n 1)"
  fi
  local maven_mode="-o"
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_AVAILABILITY_MODE="offline-default"
  if [[ "${VAADIN_DESKTOP_MAVEN_OFFLINE:-}" == "1" ]]; then
    maven_mode="-o"
    export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_AVAILABILITY_MODE="forced-offline"
  elif [[ "${VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_ONLINE:-}" == "1" ]]; then
    maven_mode="-U"
    export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_AVAILABILITY_MODE="explicit-online-local-repo"
  fi
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_EFFECTIVE_MAVEN_MODE="$maven_mode"

  if [[ -z "$vaadin_version" ]]; then
    export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_STEP_STATUS="unavailable"
    export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_STEP_SUMMARY="vaadin.version not found in root pom"
    export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_PLUGIN_RESOLUTION_STATUS="version-unavailable"
    export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_GOAL_RESULT="version-unavailable"
    return 0
  fi

  local goal="com.vaadin:vaadin-maven-plugin:${vaadin_version}:${requested_goal}"
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_PLUGIN_COORDINATES="com.vaadin:vaadin-maven-plugin:${vaadin_version}"
  local cmd=(mvn "$maven_mode" "-Dmaven.repo.local=$MAVEN_REPO" -f "$MODULE_POM" -DskipTests)
  if [[ "$requested_goal" == "build-frontend" ]]; then
    export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_PRODUCTION_MODE="true"
    export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_FORCE_PRODUCTION_BUILD="true"
    export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_IGNORE_VERSION_CHECKS="true"
    cmd+=("-Dvaadin.productionMode=true")
    cmd+=("-Dvaadin.force.production.build=true")
    cmd+=("-Dfrontend.ignore.version.checks=true")
  fi
  cmd+=("$goal")
  local redacted_command
  redacted_command="$(printf '%q ' "${cmd[@]}")"
  redacted_command="$(redact_for_trace "$redacted_command")"
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_STEP_COMMAND="$redacted_command"
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_STDOUT_LOG="$(redact_for_trace "$stdout_log")"
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_STDERR_LOG="$(redact_for_trace "$stderr_log")"

  echo "Running Flow IPC frontend build preflight: $redacted_command"
  local started_at ended_at status
  started_at="$(date +%s)"
  set +e
  "${cmd[@]}" >"$stdout_log" 2>"$stderr_log"
  status=$?
  set -e
  ended_at="$(date +%s)"

  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_STEP_EXIT_CODE="$status"
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_STEP_DURATION_MILLIS="$(((ended_at - started_at) * 1000))"
  local summary
  summary="$(single_line_log_summary "$stderr_log")"
  if [[ -z "$summary" ]]; then
    summary="$(single_line_log_summary "$stdout_log")"
  fi
  export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_STEP_SUMMARY="$summary"
  local plugin_jar="$MAVEN_REPO/com/vaadin/vaadin-maven-plugin/$vaadin_version/vaadin-maven-plugin-$vaadin_version.jar"
  if [[ "$status" == "0" ]]; then
    export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_STEP_STATUS="success"
    export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_PLUGIN_RESOLUTION_STATUS="resolved"
    export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_GOAL_RESULT="success"
    export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_OUTPUT_USABILITY="$(classify_frontend_build_output_usability)"
  elif grep -Eiq "No plugin found|PluginResolutionException|Could not find artifact|could not be resolved|Plugin .* was not found" "$stdout_log" "$stderr_log"; then
    export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_STEP_STATUS="unavailable"
    export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_PLUGIN_RESOLUTION_STATUS="missing"
    export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_GOAL_RESULT="plugin-unavailable"
  else
    export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_STEP_STATUS="failed"
    if [[ -f "$plugin_jar" ]]; then
      export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_PLUGIN_RESOLUTION_STATUS="resolved"
    else
      export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_PLUGIN_RESOLUTION_STATUS="unknown"
    fi
    export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_GOAL_RESULT="failed"
    export VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_OUTPUT_USABILITY="$(classify_frontend_build_output_usability)"
  fi
  echo "Flow IPC frontend build preflight status: $VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_STEP_STATUS ($status)"
}

case "$COMMAND" in
  dev|run)
    ensure_module
    install_module_with_dependencies
    exec mvn -U -Dmaven.repo.local="$MAVEN_REPO" -f "$MODULE_POM" spring-boot:run
    ;;
  dev-swift|run-swift|dev-native|run-native|dev-ipc|run-ipc)
    ensure_module
    install_module_with_dependencies
    run_flow_ipc_frontend_build_preflight
    if [[ ! -x /usr/bin/swiftc ]]; then
      echo "swiftc not found at /usr/bin/swiftc. Install Xcode command line tools before running the Swift host." >&2
      exit 1
    fi
    SWIFT_HOST_BUILD="$ROOT/.build/vaadin-desktop-host-swift"
    SWIFT_HOST_APP="$SWIFT_HOST_BUILD/VaadinDesktopHost.app"
    SWIFT_HOST_CONTENTS="$SWIFT_HOST_APP/Contents"
    SWIFT_HOST_MACOS="$SWIFT_HOST_CONTENTS/MacOS"
    SWIFT_HOST_EXE="$SWIFT_HOST_MACOS/VaadinDesktopHost"
    SWIFT_HOST_BUNDLE_ID="dev.vatori.desktop.host.swift"
    SWIFT_MODULE_CACHE="$ROOT/.build/clang-module-cache"
    MVN_EXE="$(command -v mvn)"
    mkdir -p "$SWIFT_HOST_MACOS"
    mkdir -p "$SWIFT_MODULE_CACHE"
    cat > "$SWIFT_HOST_CONTENTS/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>VaadinDesktopHost</string>
    <key>CFBundleIdentifier</key>
    <string>dev.vatori.desktop.host.swift</string>
    <key>CFBundleName</key>
    <string>Vaadin Desktop Host</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>LSMinimumSystemVersion</key>
    <string>12.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>
PLIST
    CLANG_MODULE_CACHE_PATH="$SWIFT_MODULE_CACHE" /usr/bin/swiftc \
      "$ROOT/vaadin-desktop-host-swift/Sources/VaadinDesktopHost/main.swift" \
      -o "$SWIFT_HOST_EXE"
    if command -v codesign >/dev/null 2>&1; then
      codesign --force --sign - "$SWIFT_HOST_APP" >/dev/null 2>&1 || true
    fi
    OPEN_ENV_ARGS=(--env "PATH=$PATH")
    forward_env_if_set() {
      local name="$1"
      if [[ -n "${!name:-}" ]]; then
        OPEN_ENV_ARGS+=(--env "$name=${!name}")
      fi
    }
    forward_env_if_set "VAADIN_DESKTOP_FLOW_IPC_PREPARE_FRONTEND"
    forward_env_if_set "VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_30"
    forward_env_if_set "VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_31"
    forward_env_if_set "VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_32"
    forward_env_if_set "VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_44"
    forward_env_if_set "VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_45"
    forward_env_if_set "VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_46"
    forward_env_if_set "VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_47"
    forward_env_if_set "VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_48"
    forward_env_if_set "VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_49"
    forward_env_if_set "VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_50"
    forward_env_if_set "VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_51"
    forward_env_if_set "VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_52"
    forward_env_if_set "VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_53"
    forward_env_if_set "VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_54"
    forward_env_if_set "VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_55"
    forward_env_if_set "VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_GOAL_NAME"
    forward_env_if_set "VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_PRODUCTION_MODE"
    forward_env_if_set "VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_FORCE_PRODUCTION_BUILD"
    forward_env_if_set "VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_IGNORE_VERSION_CHECKS"
    forward_env_if_set "VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_STEP_COMMAND"
    forward_env_if_set "VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_STEP_EXIT_CODE"
    forward_env_if_set "VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_STEP_STATUS"
    forward_env_if_set "VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_STEP_DURATION_MILLIS"
    forward_env_if_set "VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_OUTPUT_ROOTS"
    forward_env_if_set "VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_STEP_SUMMARY"
    forward_env_if_set "VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_STDOUT_LOG"
    forward_env_if_set "VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_STDERR_LOG"
    forward_env_if_set "VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_AVAILABILITY_MODE"
    forward_env_if_set "VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_EFFECTIVE_MAVEN_MODE"
    forward_env_if_set "VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_PLUGIN_COORDINATES"
    forward_env_if_set "VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_PLUGIN_RESOLUTION_STATUS"
    forward_env_if_set "VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_GOAL_RESULT"
    forward_env_if_set "VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_OUTPUT_USABILITY"
    if [[ -n "${JAVA_HOME:-}" ]]; then
      OPEN_ENV_ARGS+=(--env "JAVA_HOME=$JAVA_HOME")
    fi
    if [[ "${VAADIN_DESKTOP_FLOW_IPC_AUTO_CLICK:-}" == "1" ]]; then
      OPEN_ENV_ARGS+=(--env "VAADIN_DESKTOP_FLOW_IPC_AUTO_CLICK=1")
    fi
    if [[ "${VAADIN_DESKTOP_FLOW_IPC_AUTO_RESYNC:-}" == "1" ]]; then
      OPEN_ENV_ARGS+=(--env "VAADIN_DESKTOP_FLOW_IPC_AUTO_RESYNC=1")
    fi
    if [[ "${VAADIN_DESKTOP_FLOW_IPC_AUTO_ERROR:-}" == "1" ]]; then
      OPEN_ENV_ARGS+=(--env "VAADIN_DESKTOP_FLOW_IPC_AUTO_ERROR=1")
    fi
    if [[ "${VAADIN_DESKTOP_FLOW_IPC_AUTO_VAADIN_TEXT_FIELD:-}" == "1" ]]; then
      OPEN_ENV_ARGS+=(--env "VAADIN_DESKTOP_FLOW_IPC_AUTO_VAADIN_TEXT_FIELD=1")
    fi
    if [[ "${VAADIN_DESKTOP_FLOW_IPC_AUTO_VAADIN_TEXT_FIELD_REAL:-}" == "1" ]]; then
      OPEN_ENV_ARGS+=(--env "VAADIN_DESKTOP_FLOW_IPC_AUTO_VAADIN_TEXT_FIELD_REAL=1")
    fi
    if [[ "${VAADIN_DESKTOP_FLOW_IPC_AUTO_FRAMEWORK_UPDATE:-}" == "1" ]]; then
      OPEN_ENV_ARGS+=(--env "VAADIN_DESKTOP_FLOW_IPC_AUTO_FRAMEWORK_UPDATE=1")
    fi
    if [[ "${VAADIN_DESKTOP_FLOW_IPC_AUTO_COMPONENT_MATRIX:-}" == "1" ]]; then
      OPEN_ENV_ARGS+=(--env "VAADIN_DESKTOP_FLOW_IPC_AUTO_COMPONENT_MATRIX=1")
    fi
    if [[ "${VAADIN_DESKTOP_FLOW_IPC_AUTO_DATA_COMPONENTS:-}" == "1" ]]; then
      OPEN_ENV_ARGS+=(--env "VAADIN_DESKTOP_FLOW_IPC_AUTO_DATA_COMPONENTS=1")
    fi
    if [[ "${VAADIN_DESKTOP_FLOW_IPC_AUTO_LAZY_DATA:-}" == "1" ]]; then
      OPEN_ENV_ARGS+=(--env "VAADIN_DESKTOP_FLOW_IPC_AUTO_LAZY_DATA=1")
    fi
    if [[ "${VAADIN_DESKTOP_FLOW_IPC_AUTO_GRID_SCROLL:-}" == "1" ]]; then
      OPEN_ENV_ARGS+=(--env "VAADIN_DESKTOP_FLOW_IPC_AUTO_GRID_SCROLL=1")
    fi
    if [[ "${VAADIN_DESKTOP_FLOW_IPC_AUTO_STREAM_RESOURCE:-}" == "1" ]]; then
      OPEN_ENV_ARGS+=(--env "VAADIN_DESKTOP_FLOW_IPC_AUTO_STREAM_RESOURCE=1")
    fi
    if [[ "${VAADIN_DESKTOP_FLOW_IPC_AUTO_STREAM_RESOURCE_RANGE:-}" == "1" ]]; then
      OPEN_ENV_ARGS+=(--env "VAADIN_DESKTOP_FLOW_IPC_AUTO_STREAM_RESOURCE_RANGE=1")
    fi
    if [[ "${VAADIN_DESKTOP_FLOW_IPC_AUTO_STREAM_RESOURCE_CHUNKS:-}" == "1" ]]; then
      OPEN_ENV_ARGS+=(--env "VAADIN_DESKTOP_FLOW_IPC_AUTO_STREAM_RESOURCE_CHUNKS=1")
    fi
    if [[ "${VAADIN_DESKTOP_FLOW_IPC_AUTO_UPLOAD_RECEIVER:-}" == "1" ]]; then
      OPEN_ENV_ARGS+=(--env "VAADIN_DESKTOP_FLOW_IPC_AUTO_UPLOAD_RECEIVER=1")
    fi
    if [[ "${VAADIN_DESKTOP_FLOW_IPC_AUTO_UPLOAD_MULTIPART:-}" == "1" ]]; then
      OPEN_ENV_ARGS+=(--env "VAADIN_DESKTOP_FLOW_IPC_AUTO_UPLOAD_MULTIPART=1")
    fi
    if [[ "${VAADIN_DESKTOP_FLOW_IPC_AUTO_DOWNLOAD_SAVE_OPEN:-}" == "1" ]]; then
      OPEN_ENV_ARGS+=(--env "VAADIN_DESKTOP_FLOW_IPC_AUTO_DOWNLOAD_SAVE_OPEN=1")
    fi
    if [[ "${VAADIN_DESKTOP_FLOW_IPC_AUTO_SHUTDOWN:-}" == "1" ]]; then
      OPEN_ENV_ARGS+=(--env "VAADIN_DESKTOP_FLOW_IPC_AUTO_SHUTDOWN=1")
    fi
    OPEN_BACKGROUND=0
    if [[ "${VAADIN_DESKTOP_HOST_NO_ACTIVATE:-}" == "1" ]]; then
      OPEN_ENV_ARGS+=(--env "VAADIN_DESKTOP_HOST_NO_ACTIVATE=1")
      OPEN_BACKGROUND=1
    fi
    if [[ "${VAADIN_DESKTOP_MAVEN_OFFLINE:-}" == "1" ]]; then
      OPEN_ENV_ARGS+=(--env "VAADIN_DESKTOP_MAVEN_OFFLINE=1")
    fi
    SWIFT_HOST_STDOUT="$SWIFT_HOST_BUILD/host.out.log"
    SWIFT_HOST_STDERR="$SWIFT_HOST_BUILD/host.err.log"
    SWIFT_TRANSPORT="compatibility-http"
    if [[ "$COMMAND" == "dev-ipc" || "$COMMAND" == "run-ipc" ]]; then
      SWIFT_TRANSPORT="flow-ipc"
    fi
    : > "$SWIFT_HOST_STDOUT"
    : > "$SWIFT_HOST_STDERR"
    echo "Vaadin Desktop Host logs:"
    echo "  stdout: $SWIFT_HOST_STDOUT"
    echo "  stderr: $SWIFT_HOST_STDERR"
    tail -n +1 -f "$SWIFT_HOST_STDOUT" "$SWIFT_HOST_STDERR" &
    TAIL_PID=$!
    cleanup_tail() {
      if [[ -n "${TAIL_PID:-}" ]]; then
        kill "$TAIL_PID" 2>/dev/null || true
        wait "$TAIL_PID" 2>/dev/null || true
        TAIL_PID=""
      fi
    }
    request_swift_host_shutdown() {
      if command -v osascript >/dev/null 2>&1; then
        osascript -e "tell application id \"$SWIFT_HOST_BUNDLE_ID\" to quit" >/dev/null 2>&1 || true
      fi
      if command -v pgrep >/dev/null 2>&1; then
        for _ in 1 2 3 4 5; do
          pgrep -f "$SWIFT_HOST_EXE" >/dev/null 2>&1 || return 0
          sleep 0.2
        done
      fi
      if command -v pkill >/dev/null 2>&1; then
        pkill -f "$SWIFT_HOST_EXE" >/dev/null 2>&1 || true
      fi
    }
    handle_swift_host_interrupt() {
      trap - INT TERM
      request_swift_host_shutdown
      cleanup_tail
      exit 130
    }
    run_swift_host_open() {
      if [[ "$OPEN_BACKGROUND" == "1" ]]; then
        open -n -W -g -o "$SWIFT_HOST_STDOUT" --stderr "$SWIFT_HOST_STDERR" "${OPEN_ENV_ARGS[@]}" "$SWIFT_HOST_APP" --args \
          --module "$MODULE" \
          --repo-root "$ROOT" \
          --maven-repo "$MAVEN_REPO" \
          --maven-executable "$MVN_EXE" \
          --transport "$SWIFT_TRANSPORT"
      else
        open -n -W -o "$SWIFT_HOST_STDOUT" --stderr "$SWIFT_HOST_STDERR" "${OPEN_ENV_ARGS[@]}" "$SWIFT_HOST_APP" --args \
          --module "$MODULE" \
          --repo-root "$ROOT" \
          --maven-repo "$MAVEN_REPO" \
          --maven-executable "$MVN_EXE" \
          --transport "$SWIFT_TRANSPORT"
      fi
    }
    trap cleanup_tail EXIT
    trap handle_swift_host_interrupt INT TERM
    set +e
    run_swift_host_open
    STATUS=$?
    set -e
    cleanup_tail
    trap - EXIT INT TERM
    exit "$STATUS"
    ;;
  package)
    ensure_module
    install_module_with_dependencies
    exec mvn -U -Dmaven.repo.local="$MAVEN_REPO" -f "$MODULE_POM" -Pproduction package
    ;;
  help|--help|-h)
    cat <<USAGE
Usage:
  bin/vaadin-desktop dev <module>
  bin/vaadin-desktop dev-swift <module>
  bin/vaadin-desktop dev-ipc <module>
  bin/vaadin-desktop run <module>
  bin/vaadin-desktop package <module>

Examples:
  bin/vaadin-desktop dev examples/counter-app
  bin/vaadin-desktop dev-swift test-apps/vaadin-desktop-smoke-app
  bin/vaadin-desktop dev-ipc test-apps/flow-over-ipc-smoke-app
  bin/vaadin-desktop dev-ipc test-apps/flow-over-ipc-framework-app
  bin/vaadin-desktop dev test-apps/vaadin-desktop-smoke-app
USAGE
    ;;
  *)
    echo "Unknown command: $COMMAND" >&2
    exit 1
    ;;
esac
