#!/usr/bin/env bash

# Sourced by bin/vaadin-desktop. Expects ROOT, MODULE, COMMAND, MAVEN_REPO and MODULE_POM.

build_standard_flow_bundle() {

  local vaadin_version
  vaadin_version="$(sed -n 's:.*<vaadin.version>\(.*\)</vaadin.version>.*:\1:p' "$ROOT/pom.xml" | head -n 1)"
  if [[ -z "$vaadin_version" ]]; then
    echo "vaadin.version not found in $ROOT/pom.xml" >&2
    return 1
  fi

  local maven_mode="-U"
  if [[ "${VAADIN_DESKTOP_MAVEN_OFFLINE:-}" == "1" ]]; then
    maven_mode="-o"
  fi

  local build_dir="$ROOT/.build/flow-ipc-frontend-build"
  local stdout_log="$build_dir/build-frontend.out.log"
  local stderr_log="$build_dir/build-frontend.err.log"
  mkdir -p "$build_dir"

  local command=(
    mvn "$maven_mode"
    "-Dmaven.repo.local=$MAVEN_REPO"
    -f "$MODULE_POM"
    -DskipTests
    -Dvaadin.productionMode=true
    -Dvaadin.force.production.build=true
    -Dfrontend.ignore.version.checks=true
  )
  if [[ "${VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_COMMERCIAL_WITH_BANNER:-}" == "1" ]]; then
    command+=(-Dvaadin.commercialWithBanner=true)
  fi
  command+=("com.vaadin:vaadin-maven-plugin:${vaadin_version}:build-frontend" package)

  echo "Building standard Vaadin production bundle for $MODULE"
  if ! "${command[@]}" >"$stdout_log" 2>"$stderr_log"; then
    echo "Standard Vaadin production bundle build failed." >&2
    tail -n 20 "$stderr_log" >&2
    return 1
  fi

  local webapp_root="$ROOT/$MODULE/target/classes/META-INF/VAADIN/webapp"
  if [[ ! -f "$webapp_root/index.html" ]]; then
    echo "Standard Vaadin production bundle is incomplete: $webapp_root/index.html" >&2
    return 1
  fi
  if ! find "$ROOT/$MODULE/target" -maxdepth 1 -type f -name '*.jar' \
      ! -name '*.jar.original' | grep -q .; then
    echo "Production bundle build did not produce a runnable JAR for $MODULE." >&2
    return 1
  fi

  echo "Standard Vaadin production bundle ready"
}
