#!/usr/bin/env bash
set -euo pipefail

ROOT="${1:?repo root is required}"
TRANSPORT="${2:?transport is required}"
APPLICATION_JAR="${3:?runnable sidecar JAR is required}"
WEBAPP_ROOT="${4:-}"
CAPABILITY_MANIFEST="${5:-}"
DEVELOPMENT_WEBAPP_ORIGIN="${6:-}"
DEVELOPMENT_WEBAPP_ENTRY_PATH="${7:-}"
APPLICATION_ICON="${8:-}"
COMMON_APPLICATION_RESOURCES="${9:-}"
MACOS_APPLICATION_RESOURCES="${10:-}"
CAPABILITY_MANIFEST_FALLBACK_MODE="${11:-manifest-enforced}"
CAPABILITY_MANIFEST_STAGE_SOURCE="$CAPABILITY_MANIFEST"
CAPABILITY_MANIFEST_WORK_DIRECTORY=""

cleanup_capability_manifest_work() {
  if [[ -n "$CAPABILITY_MANIFEST_WORK_DIRECTORY" \
      && -d "$CAPABILITY_MANIFEST_WORK_DIRECTORY" ]]; then
    rm -rf -- "$CAPABILITY_MANIFEST_WORK_DIRECTORY"
  fi
}
trap cleanup_capability_manifest_work EXIT

case "$TRANSPORT" in
  flow-ipc|compatibility-http) ;;
  *)
    echo "Unsupported macOS host transport: $TRANSPORT" >&2
    exit 2
    ;;
esac

case "$CAPABILITY_MANIFEST_FALLBACK_MODE" in
  allow-all-dev|manifest-enforced) ;;
  *)
    echo "Unsupported capability manifest fallback mode: $CAPABILITY_MANIFEST_FALLBACK_MODE" >&2
    exit 2
    ;;
esac

if [[ ! -x /usr/bin/swiftc ]]; then
  echo "swiftc not found at /usr/bin/swiftc. Install Xcode command line tools before running the Swift host." >&2
  exit 1
fi
if [[ ! -f "$APPLICATION_JAR" ]]; then
  echo "Runnable sidecar JAR not found: $APPLICATION_JAR" >&2
  exit 1
fi
if [[ "$TRANSPORT" == "flow-ipc" ]]; then
  if [[ -n "$WEBAPP_ROOT" && -n "$DEVELOPMENT_WEBAPP_ORIGIN" ]]; then
    echo "flow-ipc accepts either a packaged web app or a development server, not both" >&2
    exit 1
  fi
  if [[ -z "$WEBAPP_ROOT" && -z "$DEVELOPMENT_WEBAPP_ORIGIN" ]]; then
    echo "flow-ipc requires a packaged web app or development server" >&2
    exit 1
  fi
  if [[ -n "$WEBAPP_ROOT" && ! -f "$WEBAPP_ROOT/index.html" ]]; then
    echo "Standard Vaadin production bundle not found: $WEBAPP_ROOT" >&2
    exit 1
  fi
fi

DEFAULT_HOST_ICON="$ROOT/assets/brand/vatori-icon.icns"
if [[ -n "$APPLICATION_ICON" ]]; then
  case "$APPLICATION_ICON" in
    *.icns) ;;
    *)
      echo "macOS application icon must use the .icns format: $APPLICATION_ICON" >&2
      exit 1
      ;;
  esac
fi
HOST_ICON_SOURCE="${APPLICATION_ICON:-$DEFAULT_HOST_ICON}"
if [[ ! -f "$HOST_ICON_SOURCE" ]]; then
  echo "macOS application icon not found: $HOST_ICON_SOURCE" >&2
  exit 1
fi
if [[ -L "$HOST_ICON_SOURCE" ]]; then
  echo "macOS application icon must not be a symlink: $HOST_ICON_SOURCE" >&2
  exit 1
fi
ICON_MAGIC="$(LC_ALL=C od -An -N4 -tc "$HOST_ICON_SOURCE" | tr -d '[:space:]')"
if [[ "$ICON_MAGIC" != "icns" ]]; then
  echo "macOS application icon is not a valid ICNS file: $HOST_ICON_SOURCE" >&2
  exit 1
fi
for RESOURCE_DIRECTORY in \
  "$COMMON_APPLICATION_RESOURCES" \
  "$MACOS_APPLICATION_RESOURCES"
do
  if [[ -z "$RESOURCE_DIRECTORY" ]]; then
    continue
  fi
  if [[ ! -d "$RESOURCE_DIRECTORY" || -L "$RESOURCE_DIRECTORY" ]]; then
    echo "Application resource root must be a non-symlink directory: $RESOURCE_DIRECTORY" >&2
    exit 1
  fi
  RESOURCE_SYMLINK="$(find "$RESOURCE_DIRECTORY" -type l -print -quit)"
  if [[ -n "$RESOURCE_SYMLINK" ]]; then
    echo "Application resources must be self-contained; symlink found: $RESOURCE_SYMLINK" >&2
    exit 1
  fi
done

if [[ -n "$CAPABILITY_MANIFEST" ]]; then
  if [[ ! -f "$CAPABILITY_MANIFEST" ]]; then
    echo "Capability manifest not found: $CAPABILITY_MANIFEST" >&2
    exit 1
  fi
  if [[ "$CAPABILITY_MANIFEST_FALLBACK_MODE" == "manifest-enforced" ]]; then
    CAPABILITY_MANIFEST_TEMP_ROOT="${TMPDIR:-/tmp}"
    CAPABILITY_MANIFEST_WORK_DIRECTORY="$(mktemp -d \
      "${CAPABILITY_MANIFEST_TEMP_ROOT%/}/vatori-capability-manifest.XXXXXX")"
    CAPABILITY_MANIFEST_STAGE_SOURCE="$CAPABILITY_MANIFEST_WORK_DIRECTORY/desktop-capabilities.json"
    CAPABILITY_MANIFEST_POLICY_CLASSIFICATION=""
    if ! CAPABILITY_MANIFEST_POLICY_CLASSIFICATION="$(
      /usr/bin/osascript -l JavaScript \
        -e 'ObjC.import("Foundation")' \
        -e 'function run(argv) { const sourceValue = $.NSString.stringWithContentsOfFileEncodingError(argv[0], $.NSUTF8StringEncoding, null); if (!sourceValue) throw new Error("read"); const document = JSON.parse(ObjC.unwrap(sourceValue)); const canonical = $(JSON.stringify(document)); if (!canonical.writeToFileAtomicallyEncodingError(argv[1], true, $.NSUTF8StringEncoding, null)) throw new Error("write"); if (document !== null && typeof document === "object" && !Array.isArray(document)) { if (document.permissionMode === "manifest-enforced") return "manifest-enforced"; if (document.permissionMode === "allow-all-dev") return "allow-all-dev"; if (document.permissionMode === "trace-only-dry-run") return "trace-only-dry-run"; if (!Object.prototype.hasOwnProperty.call(document, "permissionMode")) return "missing"; } return "unsupported"; }' \
        "$CAPABILITY_MANIFEST" "$CAPABILITY_MANIFEST_STAGE_SOURCE" \
        2>/dev/null
    )"; then
      echo "Product capability manifest is not valid JSON" >&2
      exit 2
    fi
    case "$CAPABILITY_MANIFEST_POLICY_CLASSIFICATION" in
      manifest-enforced) ;;
      allow-all-dev|trace-only-dry-run)
        echo "Product capability manifest must use permissionMode=manifest-enforced; found: $CAPABILITY_MANIFEST_POLICY_CLASSIFICATION" >&2
        exit 2
        ;;
      missing)
        echo "Product capability manifest must define permissionMode=manifest-enforced" >&2
        exit 2
        ;;
      *)
        echo "Product capability manifest must use permissionMode=manifest-enforced" >&2
        exit 2
        ;;
    esac
  fi
fi

HOST_BUILD="$ROOT/.build/native-hosts/macos"
HOST_APP="$HOST_BUILD/VaadinDesktopHost.app"
HOST_CONTENTS="$HOST_APP/Contents"
HOST_MACOS="$HOST_CONTENTS/MacOS"
HOST_RESOURCES="$HOST_CONTENTS/Resources"
HOST_EXE="$HOST_MACOS/VaadinDesktopHost"
MODULE_CACHE="$ROOT/.build/clang-module-cache"
SOURCE_ROOT="$ROOT/native-hosts/macos"

rm -rf "$HOST_APP"
mkdir -p "$HOST_MACOS" "$HOST_RESOURCES/Sidecar" "$MODULE_CACHE"
cp "$APPLICATION_JAR" "$HOST_RESOURCES/Sidecar/application.jar"
cp "$HOST_ICON_SOURCE" "$HOST_RESOURCES/AppIcon.icns"

APPLICATION_RESOURCES_JSON="null"
if [[ -n "$COMMON_APPLICATION_RESOURCES" \
    || -n "$MACOS_APPLICATION_RESOURCES" ]]; then
  HOST_APPLICATION_RESOURCES="$HOST_RESOURCES/Application"
  mkdir -p "$HOST_APPLICATION_RESOURCES"
  if [[ -n "$COMMON_APPLICATION_RESOURCES" ]]; then
    cp -R "$COMMON_APPLICATION_RESOURCES/." "$HOST_APPLICATION_RESOURCES/"
  fi
  if [[ -n "$MACOS_APPLICATION_RESOURCES" ]]; then
    cp -R "$MACOS_APPLICATION_RESOURCES/." "$HOST_APPLICATION_RESOURCES/"
  fi
  APPLICATION_RESOURCES_JSON='"Application"'
fi

cat > "$HOST_CONTENTS/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>VaadinDesktopHost</string>
    <key>CFBundleIdentifier</key>
    <string>dev.vatori.desktop.host.macos</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon.icns</string>
    <key>CFBundleName</key>
    <string>Vaadin Desktop Host</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>LSMinimumSystemVersion</key>
    <string>12.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>
PLIST

SWIFT_SOURCES=("$SOURCE_ROOT"/Sources/VaadinDesktopHost/*.swift)
CLANG_MODULE_CACHE_PATH="$MODULE_CACHE" /usr/bin/swiftc \
  "${SWIFT_SOURCES[@]}" \
  -framework UserNotifications \
  -o "$HOST_EXE"

cp "$SOURCE_ROOT/Resources/FlowIpcOpaqueHttpBridge.js" "$HOST_RESOURCES/"
cp "$SOURCE_ROOT/Resources/FlowIpcPushBridge.js" "$HOST_RESOURCES/"
WEBAPP_JSON="null"
DEVELOPMENT_WEBAPP_JSON="null"
if [[ "$TRANSPORT" == "flow-ipc" && -n "$WEBAPP_ROOT" ]]; then
  mkdir -p "$HOST_RESOURCES/FlowWebApp/__vatori"
  cp -R "$WEBAPP_ROOT/." "$HOST_RESOURCES/FlowWebApp/"
  cp "$SOURCE_ROOT/Resources/FlowIpcPushBridge.js" \
    "$HOST_RESOURCES/FlowWebApp/__vatori/FlowIpcPushBridge.js"
  WEBAPP_JSON='"FlowWebApp"'
fi
if [[ "$TRANSPORT" == "flow-ipc" && -n "$DEVELOPMENT_WEBAPP_ORIGIN" ]]; then
  if [[ -z "$DEVELOPMENT_WEBAPP_ENTRY_PATH" ]]; then
    echo "Development web app entry path is required" >&2
    exit 1
  fi
  DEVELOPMENT_WEBAPP_JSON=$(printf \
    '{"origin":"%s","entryPath":"%s"}' \
    "$DEVELOPMENT_WEBAPP_ORIGIN" "$DEVELOPMENT_WEBAPP_ENTRY_PATH")
fi

if [[ -n "$CAPABILITY_MANIFEST" ]]; then
  cp "$CAPABILITY_MANIFEST_STAGE_SOURCE" \
    "$HOST_RESOURCES/desktop-capabilities.json"
else
  cat > "$HOST_RESOURCES/desktop-capabilities.json" <<JSON
{"schemaVersion":1,"permissionMode":"$CAPABILITY_MANIFEST_FALLBACK_MODE","windows":[]}
JSON
fi

RESTART_LIMIT="${VAADIN_DESKTOP_FLOW_IPC_SIDECAR_RESTART_LIMIT:-3}"
READY_TIMEOUT="${VAADIN_DESKTOP_FLOW_IPC_SIDECAR_RECOVERY_READY_TIMEOUT_SECONDS:-15}"
STABLE_RUN_SECONDS="${VAADIN_DESKTOP_FLOW_IPC_SIDECAR_RECOVERY_STABLE_RUN_SECONDS:-30}"
INITIAL_READY_TIMEOUT="${VAADIN_DESKTOP_SIDECAR_INITIAL_READY_TIMEOUT_SECONDS:-30}"
cat > "$HOST_RESOURCES/VatoriHost.json" <<JSON
{
  "version": 1,
  "transport": "$TRANSPORT",
  "sidecarJar": "Sidecar/application.jar",
  "webApp": $WEBAPP_JSON,
  "webAppDevelopmentServer": $DEVELOPMENT_WEBAPP_JSON,
  "applicationResources": $APPLICATION_RESOURCES_JSON,
  "opaqueBridge": "FlowIpcOpaqueHttpBridge.js",
  "pushBridge": "FlowIpcPushBridge.js",
  "capabilityManifest": "desktop-capabilities.json",
  "sidecarStartup": {
    "readyTimeoutSeconds": $INITIAL_READY_TIMEOUT
  },
  "recovery": {
    "restartLimit": $RESTART_LIMIT,
    "readyTimeoutSeconds": $READY_TIMEOUT,
    "stableRunSeconds": $STABLE_RUN_SECONDS
  }
}
JSON

if command -v codesign >/dev/null 2>&1; then
  codesign --force --sign - "$HOST_APP" >/dev/null 2>&1 || true
fi

echo "Built macOS host: $HOST_APP"
