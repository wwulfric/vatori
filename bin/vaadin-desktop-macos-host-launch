#!/usr/bin/env bash

# Generic launch helper used by the explicit acceptance overlay. The production
# CLI launches the staged app directly and does not know test-support flags.

launch_built_macos_host_runtime() {
    local host_app="${1:?macOS host app is required}"
    shift
    local forwarded_environment_names=("$@")
    local host_build
    host_build="$(dirname "$host_app")"
    local host_exe="$host_app/Contents/MacOS/VaadinDesktopHost"
    local host_bundle_id="dev.vatori.desktop.host.macos"
    local stdout_log="$host_build/host.out.log"
    local stderr_log="$host_build/host.err.log"
    local open_env_args=(--env "PATH=$PATH")
    if [[ -n "${JAVA_HOME:-}" ]]; then
      open_env_args+=(--env "JAVA_HOME=$JAVA_HOME")
    fi
    local name
    for name in "${forwarded_environment_names[@]}"; do
      if [[ -n "${!name:-}" ]]; then
        open_env_args+=(--env "$name=${!name}")
      fi
    done

    : > "$stdout_log"
    : > "$stderr_log"
    echo "Vaadin Desktop Host logs:"
    echo "  stdout: $stdout_log"
    echo "  stderr: $stderr_log"

    local tail_pid=""
    if [[ "${VAADIN_DESKTOP_MACOS_LOG_FOLLOW:-1}" == "1" ]]; then
      tail -n +1 -f "$stdout_log" "$stderr_log" &
      tail_pid=$!
    fi
    cleanup_tail() {
      if [[ -n "$tail_pid" ]]; then
        kill "$tail_pid" 2>/dev/null || true
        wait "$tail_pid" 2>/dev/null || true
        tail_pid=""
      fi
    }
    request_shutdown() {
      osascript -e "tell application id \"$host_bundle_id\" to quit" >/dev/null 2>&1 || true
      pkill -f "$host_exe" >/dev/null 2>&1 || true
    }
    handle_interrupt() {
      trap - INT TERM
      request_shutdown
      cleanup_tail
      exit 130
    }

    trap cleanup_tail EXIT
    trap handle_interrupt INT TERM
    local open_args=(open -n -W)
    if [[ "${VAADIN_DESKTOP_MACOS_NO_ACTIVATE:-}" == "1" ]]; then
      open_args+=(-g)
    fi
    open_args+=(-o "$stdout_log" --stderr "$stderr_log")
    open_args+=("${open_env_args[@]}" "$host_app")
    set +e
    "${open_args[@]}"
    local status=$?
    set -e
    cleanup_tail
    trap - EXIT INT TERM
    return "$status"
}
