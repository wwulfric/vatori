# Swift/AppKit host launch helpers for bin/vaadin-desktop.
# This file is sourced and expects ROOT, MODULE, COMMAND, MAVEN_REPO and PATH.

run_swift_host_runtime() {
    SWIFT_HOST_BUILD="$ROOT/.build/vaadin-desktop-host-swift"
    SWIFT_HOST_APP="$SWIFT_HOST_BUILD/VaadinDesktopHost.app"
    SWIFT_HOST_EXE="$SWIFT_HOST_APP/Contents/MacOS/VaadinDesktopHost"
    SWIFT_HOST_BUNDLE_ID="dev.vatori.desktop.host.swift"
    MVN_EXE="$(command -v mvn)"
    bash "$ROOT/bin/vaadin-desktop-build-swift-host" "$ROOT"
    OPEN_ENV_ARGS=(--env "PATH=$PATH")
    forward_env_if_set() {
      local name="$1"
      if [[ -n "${!name:-}" ]]; then
        OPEN_ENV_ARGS+=(--env "$name=${!name}")
      fi
    }
    FORWARDED_VALUE_ENV_VARS=(
      VAADIN_DESKTOP_FLOW_IPC_PREPARE_FRONTEND
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_30
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_31
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_32
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_44
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_45
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_46
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_47
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_48
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_49
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_50
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_51
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_52
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_53
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_54
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_55
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_57
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_58
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_59
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_60
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_62
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_63
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_V1_64
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_COMMERCIAL_WITH_BANNER
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_MAVEN_GOAL_NAME
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_GOAL_NAME
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_PRODUCTION_MODE
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_FORCE_PRODUCTION_BUILD
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_IGNORE_VERSION_CHECKS
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_STEP_COMMAND
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_STEP_EXIT_CODE
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_STEP_STATUS
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_STEP_DURATION_MILLIS
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_OUTPUT_ROOTS
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_STEP_SUMMARY
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_STDOUT_LOG
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_STDERR_LOG
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_AVAILABILITY_MODE
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_EFFECTIVE_MAVEN_MODE
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_PLUGIN_COORDINATES
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_PLUGIN_RESOLUTION_STATUS
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_MAVEN_GOAL_RESULT
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_GOAL_RESULT
      VAADIN_DESKTOP_FLOW_IPC_FRONTEND_BUILD_OUTPUT_USABILITY
    )
    for name in "${FORWARDED_VALUE_ENV_VARS[@]}"; do
      forward_env_if_set "$name"
    done
    if [[ -n "${JAVA_HOME:-}" ]]; then
      OPEN_ENV_ARGS+=(--env "JAVA_HOME=$JAVA_HOME")
    fi
    forward_swift_host_auto_flag() {
      local name="$1"
      local arg="${2:-}"
      if [[ "${!name:-}" == "1" ]]; then
        OPEN_ENV_ARGS+=(--env "$name=1")
        if [[ -n "$arg" ]]; then
          SWIFT_HOST_EXTRA_ARGS+=("$arg")
        fi
      fi
    }
    SWIFT_HOST_EXTRA_ARGS=()
    while read -r name arg; do
      [[ -n "$name" ]] || continue
      forward_swift_host_auto_flag "$name" "${arg:-}"
    done <<'SWIFT_HOST_AUTO_FLAG_SPECS'
VAADIN_DESKTOP_FLOW_IPC_AUTO_CLICK
VAADIN_DESKTOP_FLOW_IPC_AUTO_RESYNC
VAADIN_DESKTOP_FLOW_IPC_AUTO_ERROR
VAADIN_DESKTOP_FLOW_IPC_AUTO_FILE_DIALOG_CANCEL
VAADIN_DESKTOP_FLOW_IPC_AUTO_VAADIN_TEXT_FIELD
VAADIN_DESKTOP_FLOW_IPC_AUTO_VAADIN_TEXT_FIELD_REAL
VAADIN_DESKTOP_FLOW_IPC_AUTO_FRAMEWORK_UPDATE
VAADIN_DESKTOP_FLOW_IPC_AUTO_COMPONENT_MATRIX
VAADIN_DESKTOP_FLOW_IPC_AUTO_DATA_COMPONENTS
VAADIN_DESKTOP_FLOW_IPC_AUTO_INPUT_COMPONENTS
VAADIN_DESKTOP_FLOW_IPC_AUTO_NAVIGATION_COMPONENTS
VAADIN_DESKTOP_FLOW_IPC_AUTO_OVERLAY_COMPONENTS
VAADIN_DESKTOP_FLOW_IPC_AUTO_RICH_CONTENT_COMPONENTS
VAADIN_DESKTOP_FLOW_IPC_AUTO_RICH_TEXT_EDITOR
VAADIN_DESKTOP_FLOW_IPC_AUTO_RICH_TEXT_EDITOR_BEHAVIOR
VAADIN_DESKTOP_FLOW_IPC_AUTO_RICH_TEXT_EDITOR_EDITING
VAADIN_DESKTOP_FLOW_IPC_AUTO_RICH_TEXT_EDITOR_THEME
VAADIN_DESKTOP_FLOW_IPC_AUTO_NATIVE_CLIPBOARD_READ
VAADIN_DESKTOP_FLOW_IPC_AUTO_BUTTON_THEME
VAADIN_DESKTOP_FLOW_IPC_AUTO_TEXT_FIELD_THEME
VAADIN_DESKTOP_FLOW_IPC_AUTO_SELECT_THEME
VAADIN_DESKTOP_FLOW_IPC_AUTO_COMBO_BOX_THEME
VAADIN_DESKTOP_FLOW_IPC_AUTO_DATE_PICKER_THEME
VAADIN_DESKTOP_FLOW_IPC_AUTO_MULTI_SELECT_COMBO_BOX_THEME
VAADIN_DESKTOP_FLOW_IPC_AUTO_TIME_PICKER_THEME
VAADIN_DESKTOP_FLOW_IPC_AUTO_TEXT_AREA_THEME
VAADIN_DESKTOP_FLOW_IPC_AUTO_EMAIL_FIELD_THEME
VAADIN_DESKTOP_FLOW_IPC_AUTO_INTEGER_FIELD_THEME
VAADIN_DESKTOP_FLOW_IPC_AUTO_PASSWORD_FIELD_THEME
VAADIN_DESKTOP_FLOW_IPC_AUTO_BIG_DECIMAL_FIELD_THEME
VAADIN_DESKTOP_FLOW_IPC_AUTO_CHECKBOX_THEME
VAADIN_DESKTOP_FLOW_IPC_AUTO_RADIO_BUTTON_GROUP_THEME
VAADIN_DESKTOP_FLOW_IPC_AUTO_TABS_THEME
VAADIN_DESKTOP_FLOW_IPC_AUTO_DETAILS_THEME
VAADIN_DESKTOP_FLOW_IPC_AUTO_MENU_BAR_THEME
VAADIN_DESKTOP_FLOW_IPC_AUTO_GRID_THEME
VAADIN_DESKTOP_FLOW_IPC_AUTO_AVATAR_THEME
VAADIN_DESKTOP_FLOW_IPC_AUTO_AVATAR_GROUP_THEME
VAADIN_DESKTOP_FLOW_IPC_AUTO_MESSAGE_INPUT_THEME
VAADIN_DESKTOP_FLOW_IPC_AUTO_SIDE_NAV_THEME
VAADIN_DESKTOP_FLOW_IPC_AUTO_MESSAGE_LIST_MARKDOWN
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_OVERLAY_PROPERTIES
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_OVERLAY_FORGOT_PASSWORD
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_OVERLAY_LOGIN
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_OVERLAY_INVALID_LOGIN
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_OVERLAY_CLOSE
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_OVERLAY_RECOVERY_LOGIN
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_OVERLAY_SERVER_REOPEN
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_OVERLAY_SHOW_ERROR
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_OVERLAY_ERROR_A11Y --flow-ipc-auto-login-overlay-error-a11y
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_OVERLAY_ERROR_FOCUS --flow-ipc-auto-login-overlay-error-focus
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_OVERLAY_ERROR_FOCUS_RETRY --flow-ipc-auto-login-overlay-error-focus-retry
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_OVERLAY_ERROR_FOCUS_RETRY_TARGET --flow-ipc-auto-login-overlay-error-focus-retry-target
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_OVERLAY_ACTION_POST --flow-ipc-auto-login-overlay-action-post
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_OVERLAY_SUBMIT_BUTTON --flow-ipc-auto-login-overlay-submit-button
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_OVERLAY_ENTER_SUBMIT --flow-ipc-auto-login-overlay-enter-submit
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_OVERLAY_I18N_FULL --flow-ipc-auto-login-overlay-i18n-full
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_OVERLAY_NO_AUTOFOCUS --flow-ipc-auto-login-overlay-no-autofocus
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_OVERLAY_AUTOFOCUS_CONTROL --flow-ipc-auto-login-overlay-autofocus-control
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_OVERLAY_ESC_CLOSE --flow-ipc-auto-login-overlay-esc-close
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_OVERLAY_OUTSIDE_CLOSE --flow-ipc-auto-login-overlay-outside-close
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_OVERLAY_TAB_TRAVERSAL --flow-ipc-auto-login-overlay-tab-traversal
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_OVERLAY_SHIFT_TAB_TRAVERSAL --flow-ipc-auto-login-overlay-shift-tab-traversal
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_OVERLAY_AUTOFILL_ATTRIBUTES --flow-ipc-auto-login-overlay-autofill-attributes
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_OVERLAY_A11Y_SEMANTICS --flow-ipc-auto-login-overlay-a11y-semantics
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_OVERLAY_DISABLED_GUARD --flow-ipc-auto-login-overlay-disabled-guard
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_OVERLAY_DISABLED_KEYBOARD_GUARD --flow-ipc-auto-login-overlay-disabled-keyboard-guard
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_FORM_PROPERTIES
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_FORM_LOGIN
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_FORM_INVALID_LOGIN
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_FORM_FORGOT_PASSWORD
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_FORM_ACTION_POST
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_FORM_SUBMIT_BUTTON
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_FORM_ENTER_SUBMIT
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_FORM_RECOVERY_LOGIN
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_FORM_ENABLED_LIFECYCLE --flow-ipc-auto-login-form-enabled-lifecycle
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_FORM_DISABLED_GUARD --flow-ipc-auto-login-form-disabled-guard
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_FORM_DISABLED_KEYBOARD_GUARD --flow-ipc-auto-login-form-disabled-keyboard-guard
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_FORM_NO_AUTOFOCUS --flow-ipc-auto-login-form-no-autofocus
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_FORM_AUTOFOCUS_CONTROL --flow-ipc-auto-login-form-autofocus-control
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_FORM_TAB_TRAVERSAL --flow-ipc-auto-login-form-tab-traversal
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_FORM_SHIFT_TAB_TRAVERSAL --flow-ipc-auto-login-form-shift-tab-traversal
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_FORM_AUTOFILL_ATTRIBUTES --flow-ipc-auto-login-form-autofill-attributes
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_FORM_A11Y_SEMANTICS --flow-ipc-auto-login-form-a11y-semantics
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_FORM_I18N_FULL --flow-ipc-auto-login-form-i18n-full
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_FORM_SHOW_ERROR --flow-ipc-auto-login-form-show-error
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_FORM_ERROR_A11Y --flow-ipc-auto-login-form-error-a11y
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_FORM_ERROR_FOCUS --flow-ipc-auto-login-form-error-focus
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_FORM_ERROR_FOCUS_RETRY --flow-ipc-auto-login-form-error-focus-retry
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_FORM_ERROR_FOCUS_RETRY_TARGET --flow-ipc-auto-login-form-error-focus-retry-target
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_FORM_ERROR_FOCUS_RETRY_TARGET_STATE --flow-ipc-auto-login-form-error-focus-retry-target-state
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_FORM_ERROR_FOCUS_RETRY_TARGET_LAYOUT --flow-ipc-auto-login-form-error-focus-retry-target-layout
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_FORM_ERROR_FOCUS_RETRY_TARGET_HIDDEN_SOURCE --flow-ipc-auto-login-form-error-focus-retry-target-hidden-source
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_FORM_ERROR_FOCUS_RETRY_TARGET_VISIBLE_OWNER --flow-ipc-auto-login-form-error-focus-retry-target-visible-owner
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_FORM_ERROR_FOCUS_RETRY_TARGET_VISIBLE_OWNER_FOCUS --flow-ipc-auto-login-form-error-focus-retry-target-visible-owner-focus
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_FORM_ERROR_FOCUS_RETRY_TARGET_VISIBLE_OWNER_FOCUS_CONTAINMENT --flow-ipc-auto-login-form-error-focus-retry-target-visible-owner-focus-containment
VAADIN_DESKTOP_FLOW_IPC_AUTO_LOGIN_FORM_ERROR_FOCUS_RETRY_TARGET_VISIBLE_OWNER_FOCUS_CONTAINMENT_STABILITY --flow-ipc-auto-login-form-error-focus-retry-target-visible-owner-focus-containment-stability
VAADIN_DESKTOP_FLOW_IPC_AUTO_LIFECYCLE_FOCUS
VAADIN_DESKTOP_FLOW_IPC_AUTO_LAZY_DATA
VAADIN_DESKTOP_FLOW_IPC_AUTO_GRID_SCROLL
VAADIN_DESKTOP_FLOW_IPC_AUTO_STREAM_RESOURCE
VAADIN_DESKTOP_FLOW_IPC_AUTO_STREAM_RESOURCE_RANGE
VAADIN_DESKTOP_FLOW_IPC_AUTO_STREAM_RESOURCE_CHUNKS
VAADIN_DESKTOP_FLOW_IPC_AUTO_UPLOAD_RECEIVER
VAADIN_DESKTOP_FLOW_IPC_AUTO_UPLOAD_MULTIPART
VAADIN_DESKTOP_FLOW_IPC_AUTO_DOWNLOAD_SAVE_OPEN
VAADIN_DESKTOP_FLOW_IPC_AUTO_SHUTDOWN
SWIFT_HOST_AUTO_FLAG_SPECS
    if [[ -n "${VAADIN_DESKTOP_FLOW_IPC_AUTO_SHUTDOWN_TIMEOUT_SECONDS:-}" ]]; then
      OPEN_ENV_ARGS+=(--env "VAADIN_DESKTOP_FLOW_IPC_AUTO_SHUTDOWN_TIMEOUT_SECONDS=$VAADIN_DESKTOP_FLOW_IPC_AUTO_SHUTDOWN_TIMEOUT_SECONDS")
    fi
    OPEN_BACKGROUND=0
    if [[ "${VAADIN_DESKTOP_HOST_NO_ACTIVATE:-}" == "1" ]]; then
      OPEN_ENV_ARGS+=(--env "VAADIN_DESKTOP_HOST_NO_ACTIVATE=1")
      OPEN_BACKGROUND=1
    fi
    if [[ "${VAADIN_DESKTOP_MAVEN_OFFLINE:-}" == "1" ]]; then
      OPEN_ENV_ARGS+=(--env "VAADIN_DESKTOP_MAVEN_OFFLINE=1")
    fi
    SWIFT_HOST_STDOUT="$SWIFT_HOST_BUILD/host.out.log"
    SWIFT_HOST_STDERR="$SWIFT_HOST_BUILD/host.err.log"
    SWIFT_TRANSPORT="compatibility-http"
    if [[ "$COMMAND" == "dev-ipc" || "$COMMAND" == "run-ipc" ]]; then
      SWIFT_TRANSPORT="flow-ipc"
    fi
    : > "$SWIFT_HOST_STDOUT"
    : > "$SWIFT_HOST_STDERR"
    echo "Vaadin Desktop Host logs:"
    echo "  stdout: $SWIFT_HOST_STDOUT"
    echo "  stderr: $SWIFT_HOST_STDERR"
    tail -n +1 -f "$SWIFT_HOST_STDOUT" "$SWIFT_HOST_STDERR" &
    TAIL_PID=$!
    cleanup_tail() {
      if [[ -n "${TAIL_PID:-}" ]]; then
        kill "$TAIL_PID" 2>/dev/null || true
        wait "$TAIL_PID" 2>/dev/null || true
        TAIL_PID=""
      fi
    }
    request_swift_host_shutdown() {
      if command -v osascript >/dev/null 2>&1; then
        osascript -e "tell application id \"$SWIFT_HOST_BUNDLE_ID\" to quit" >/dev/null 2>&1 || true
      fi
      if command -v pgrep >/dev/null 2>&1; then
        for _ in 1 2 3 4 5; do
          pgrep -f "$SWIFT_HOST_EXE" >/dev/null 2>&1 || return 0
          sleep 0.2
        done
      fi
      if command -v pkill >/dev/null 2>&1; then
        pkill -f "$SWIFT_HOST_EXE" >/dev/null 2>&1 || true
      fi
    }
    handle_swift_host_interrupt() {
      trap - INT TERM
      request_swift_host_shutdown
      cleanup_tail
      exit 130
    }
    run_swift_host_open() {
      local open_args=(open -n -W)
      if [[ "$OPEN_BACKGROUND" == "1" ]]; then
        open_args+=(-g)
      fi
      open_args+=(-o "$SWIFT_HOST_STDOUT" --stderr "$SWIFT_HOST_STDERR")
      open_args+=("${OPEN_ENV_ARGS[@]}")
      open_args+=("$SWIFT_HOST_APP" --args \
        --module "$MODULE" \
        --repo-root "$ROOT" \
        --maven-repo "$MAVEN_REPO" \
        --maven-executable "$MVN_EXE" \
        --transport "$SWIFT_TRANSPORT")
      if (( ${#SWIFT_HOST_EXTRA_ARGS[@]} > 0 )); then
        open_args+=("${SWIFT_HOST_EXTRA_ARGS[@]}")
      fi
      "${open_args[@]}"
    }
    trap cleanup_tail EXIT
    trap handle_swift_host_interrupt INT TERM
    set +e
    run_swift_host_open
    STATUS=$?
    set -e
    cleanup_tail
    trap - EXIT INT TERM
    return "$STATUS"
}
