<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>dev.vatori</groupId>
    <artifactId>vaadin-desktop-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>vatori</name>

    <modules>
        <module>vaadin-desktop-core</module>
        <module>vaadin-desktop-ipc</module>
        <module>vaadin-desktop-host</module>
        <module>vaadin-desktop-flow</module>
        <module>vaadin-desktop-devtools</module>
        <module>vaadin-desktop-cli</module>
        <module>examples/counter-app</module>
        <module>examples/grid-app</module>
        <module>examples/desktop-capabilities-app</module>
        <module>examples/component-gallery-app</module>
        <module>test-apps/vaadin-desktop-smoke-app</module>
        <module>test-apps/flow-over-ipc-smoke-app</module>
        <module>test-apps/flow-over-ipc-framework-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <vaadin.version>25.1.5</vaadin.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-bom</artifactId>
                <version>${vaadin.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
