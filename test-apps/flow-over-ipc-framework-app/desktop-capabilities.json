{
  "schemaVersion": 1,
  "permissionMode": "manifest-enforced",
  "windows": [
    {
      "label": "transfer-secondary",
      "commands": ["window.open", "window.close"]
    },
    {
      "label": "churn-secondary",
      "commands": ["window.open", "window.close", "window.setTitle"]
    },
    {
      "label": "churn-sibling",
      "commands": ["window.open", "window.close", "window.setTitle"]
    },
    {
      "label": "runtime-observer",
      "commands": ["window.open", "window.close", "runtime.replacement.status", "runtime.replacement.request"]
    },
    {
      "label": "main",
      "commands": [
        "window.setTitle",
        "runtime.replacement.status",
        "runtime.replacement.request",
        "clipboard.writeText",
        "clipboard.readText",
        "notification.show",
        "fileDialog.openFile",
        "fileDialog.saveNewWriteGrant",
        "fileGrant.write",
        "fileGrant.releaseWrite",
        "fileGrant.cancelWrite",
        "fileTransfer.download",
        "window.close"
      ]
    },
    {
      "label": "multipart-secondary",
      "commands": [
        "window.open",
        "window.close"
      ]
    },
    {
      "label": "native-edit-secondary",
      "commands": [
        "window.open",
        "window.close"
      ]
    },
    {
      "label": "permission-secondary",
      "commands": [
        "window.open",
        "window.close"
      ]
    },
    {
      "label": "capability-reopen-secondary",
      "commands": [
        "window.open",
        "window.close",
        "window.setTitle"
      ]
    },
    {
      "label": "file-dialog-outcomes-secondary",
      "commands": [
        "window.open",
        "window.close"
      ]
    },
    {
      "label": "file-read-grant-secondary",
      "commands": [
        "window.open",
        "window.close",
        "fileDialog.openReadGrant",
        "fileGrant.read",
        "fileGrant.release"
      ]
    },
    {
      "label": "file-read-grant-isolation-secondary",
      "commands": [
        "window.open",
        "window.close",
        "fileDialog.openReadGrant",
        "fileGrant.read",
        "fileGrant.release"
      ]
    },
    {
      "label": "file-read-grant-replay-secondary",
      "commands": [
        "window.open",
        "window.close",
        "fileDialog.openReadGrant",
        "fileGrant.read",
        "fileGrant.release"
      ]
    },
    {
      "label": "owner-close-secondary",
      "commands": [
        "window.open",
        "window.close",
        "fileDialog.openFile"
      ]
    },
    {
      "label": "main-close-recovery-secondary",
      "commands": [
        "window.open",
        "window.setTitle"
      ]
    },
    {
      "label": "clipboard-outcomes-secondary",
      "commands": [
        "window.open",
        "window.close"
      ]
    }
  ]
}
