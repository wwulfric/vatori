#!/usr/bin/env bash
set -euo pipefail

ROOT="${1:?repo root is required}"
MODULE="${2:-}"
TRANSPORT="${3:?transport is required}"
ACCEPTANCE_ROOT="$ROOT/test-support/native-host-macos-acceptance"
PRODUCTION_SOURCE_ROOT="$ROOT/native-hosts/macos/Sources/VaadinDesktopHost"
PRODUCTION_FACTORY="ProductionHostRuntimeObserverFactory.swift"
PRODUCTION_FACTORY_PATH="$PRODUCTION_SOURCE_ROOT/$PRODUCTION_FACTORY"
HOST_APP="$ROOT/.build/native-hosts/macos/VaadinDesktopHost.app"
HOST_EXE="$HOST_APP/Contents/MacOS/VaadinDesktopHost"
MODULE_CACHE="$ROOT/.build/clang-module-cache"

MODULE_ROOT="$ROOT/$MODULE"
RUNNABLE_JARS=()
while IFS= read -r jar; do
  RUNNABLE_JARS+=("$jar")
done < <(find "$MODULE_ROOT/target" -maxdepth 1 -type f -name '*.jar' \
  ! -name '*-sources.jar' ! -name '*-javadoc.jar' ! -name 'original-*' \
  ! -name '*.jar.original' -print | sort)
if [[ "${#RUNNABLE_JARS[@]}" != "1" ]]; then
  echo "Expected one runnable application JAR, found ${#RUNNABLE_JARS[@]}" >&2
  exit 1
fi
WEBAPP_ROOT=""
if [[ "$TRANSPORT" == "flow-ipc" ]]; then
  WEBAPP_ROOT="$MODULE_ROOT/target/classes/META-INF/VAADIN/webapp"
fi
CAPABILITY_MANIFEST=""
if [[ -n "${VAADIN_DESKTOP_ACCEPTANCE_CAPABILITY_MANIFEST:-}" ]]; then
  if [[ "${VAADIN_DESKTOP_ACCEPTANCE_OMIT_CAPABILITY_MANIFEST:-}" == "1" ]]; then
    echo "Cannot both override and omit the acceptance capability manifest." >&2
    exit 1
  fi
  if [[ ! -f "$VAADIN_DESKTOP_ACCEPTANCE_CAPABILITY_MANIFEST" ]]; then
    echo "Acceptance capability manifest override must be an existing regular file." >&2
    exit 1
  fi
  CAPABILITY_MANIFEST="$VAADIN_DESKTOP_ACCEPTANCE_CAPABILITY_MANIFEST"
elif [[ "${VAADIN_DESKTOP_ACCEPTANCE_OMIT_CAPABILITY_MANIFEST:-}" != "1" \
    && -f "$MODULE_ROOT/desktop-capabilities.json" ]]; then
  CAPABILITY_MANIFEST="$MODULE_ROOT/desktop-capabilities.json"
fi
CAPABILITY_MANIFEST_FALLBACK_MODE="${VAADIN_DESKTOP_ACCEPTANCE_CAPABILITY_MANIFEST_FALLBACK_MODE:-allow-all-dev}"

bash "$ROOT/bin/vaadin-desktop-build-macos-host" \
  "$ROOT" "$TRANSPORT" "${RUNNABLE_JARS[0]}" "$WEBAPP_ROOT" \
  "$CAPABILITY_MANIFEST" "" "" "" "" "" \
  "$CAPABILITY_MANIFEST_FALLBACK_MODE"

if [[ ! -d "$ACCEPTANCE_ROOT/Sources/VaadinDesktopHostAcceptanceSupport" ]]; then
  echo "macOS host acceptance sources are missing: $ACCEPTANCE_ROOT" >&2
  exit 1
fi
if [[ ! -f "$PRODUCTION_FACTORY_PATH" ]]; then
  echo "macOS production host composition root is missing: $PRODUCTION_FACTORY_PATH" >&2
  exit 1
fi

host_sources=()
for source in "$PRODUCTION_SOURCE_ROOT"/*.swift; do
  if [[ "$(basename "$source")" != "$PRODUCTION_FACTORY" ]]; then
    host_sources+=("$source")
  fi
done
host_sources+=(
  "$ACCEPTANCE_ROOT"/Sources/VaadinDesktopHostAcceptanceSupport/*.swift
)

CLANG_MODULE_CACHE_PATH="$MODULE_CACHE" /usr/bin/swiftc \
  "${host_sources[@]}" \
  -framework UserNotifications \
  -o "$HOST_EXE"

if command -v codesign >/dev/null 2>&1; then
  codesign --force --sign - "$HOST_APP" >/dev/null 2>&1 || true
fi

echo "Built explicit macOS acceptance host: $HOST_APP"
