#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
if [[ -z "${JAVA_HOME:-}" || ! -x "$JAVA_HOME/bin/javac" ]]; then
  echo "Set JAVA_HOME to a complete local JDK." >&2
  exit 2
fi
node "$ROOT/test-support/native-host-macos-acceptance/Tests/fatal-protocol-startup-smoke.mjs"
