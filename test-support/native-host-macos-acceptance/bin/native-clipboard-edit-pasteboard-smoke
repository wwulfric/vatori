#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
BUILD_DIR="$ROOT/.build/test-support/native-clipboard-edit-pasteboard-smoke"
MODULE_CACHE="$ROOT/.build/clang-module-cache"
EXECUTABLE="$BUILD_DIR/native-clipboard-edit-pasteboard-smoke"

mkdir -p "$BUILD_DIR" "$MODULE_CACHE"
CLANG_MODULE_CACHE_PATH="$MODULE_CACHE" /usr/bin/swiftc \
  "$ROOT/test-support/native-host-macos-acceptance/Sources/VaadinDesktopHostAcceptanceSupport/NativeClipboardEditPasteboardGuard.swift" \
  "$ROOT/test-support/native-host-macos-acceptance/Tests/native-clipboard-edit-pasteboard-smoke.swift" \
  -o "$EXECUTABLE"
"$EXECUTABLE"
