#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
ACCEPTANCE="$ROOT/test-support/native-host-macos-acceptance"
[[ $# -ge 1 && $# -le 2 ]] || { echo "Usage: $0 permission|default-deny|last-window-close|main-window-close-recovery|file-dialog-outcomes|capability-owner-window-close|capability-generation-recovery|clipboard-contention [prepared-app]" >&2; exit 2; }
PROFILE="$1"
case "$PROFILE" in
  permission) FLAG=CAPABILITY_PERMISSION; GATE=capability-permission; TIMEOUT=90 ;;
  default-deny) FLAG=CAPABILITY_DEFAULT_DENY; GATE=capability-default-deny; TIMEOUT=60 ;;
  last-window-close) FLAG=LAST_WINDOW_CLOSE; GATE=last-window-close; TIMEOUT=45 ;;
  main-window-close-recovery) FLAG=MAIN_WINDOW_CLOSE_RECOVERY; GATE=main-window-close-recovery; TIMEOUT=75 ;;
  file-dialog-outcomes) FLAG=FILE_DIALOG_OUTCOMES; GATE=file-dialog-outcomes; TIMEOUT=60 ;;
  capability-owner-window-close) FLAG=CAPABILITY_OWNER_WINDOW_CLOSE; GATE=capability-owner-window-close; TIMEOUT=60 ;;
  capability-generation-recovery) FLAG=CAPABILITY_GENERATION_RECOVERY; GATE=capability-generation-recovery; TIMEOUT=75 ;;
  clipboard-contention) FLAG=CLIPBOARD_OUTCOMES; GATE=clipboard-outcomes; TIMEOUT=75 ;;
  *) echo "Unknown capability baseline profile: $PROFILE" >&2; exit 2 ;;
esac
if [[ "$PROFILE" == clipboard-contention && "${VATORI_TEST_CLIPBOARD_AUTHORIZED:-}" != 1 ]]; then
  echo 'Clipboard contention requires fresh explicit authorization; set VATORI_TEST_CLIPBOARD_AUTHORIZED=1 only for that authorized invocation.' >&2
  exit 2
fi
PREPARED_APP="${2:-}"
if [[ "$PROFILE" == default-deny && -n "$PREPARED_APP" ]]; then
  echo 'Default-deny requires actual source-manifest omission through the builder, not a modified prepared manifest.' >&2
  exit 2
fi
[[ -z "$PREPARED_APP" || ( "$PREPARED_APP" == /* && -d "$PREPARED_APP" ) ]] || exit 2
[[ "$(uname -s)" == Darwin && -x "${JAVA_HOME:?Set JAVA_HOME}/bin/java" ]]
if [[ "${VATORI_NATIVE_HOST_MACOS_ACCEPTANCE_PACKAGE_LOCK_HELD:-}" != 1 ]]; then
  exec env VATORI_NATIVE_HOST_MACOS_ACCEPTANCE_PACKAGE_LOCK_HELD=1 \
    bash "$ACCEPTANCE/bin/with-package-lock" -- bash "$0" "$@"
fi
cd "$ROOT"
umask 077
mkdir -p "$ROOT/.build/native-hosts/macos"
EVIDENCE="$(mktemp -d "$ROOT/.build/native-hosts/macos/capability-$PROFILE-evidence.XXXXXX")"
APP="$EVIDENCE/Launched.app"
EXE="$APP/Contents/MacOS/VaadinDesktopHost"
JAR="$APP/Contents/Resources/Sidecar/application.jar"
OPEN_PID=""
echo "Evidence: $EVIDENCE"
owned_pids() {
  ps -axo pid=,command= | awk -v host="$EXE" -v jar="$JAR" -v java="$JAVA_HOME/bin/java" -v contender="$EVIDENCE/clipboard-contender " '
    {pid=$1; $1=""; sub(/^ +/, ""); if ($0 == host || $0 == java " -jar " jar || index($0, contender) == 1) print pid;}'
}
finish() {
  local status="$1" remaining pid attempt=0
  trap - EXIT
  trap '' HUP INT TERM
  printf '%s\n' "$status" > "$EVIDENCE/primary-exit-status.txt"
  if ! remaining="$(owned_pids)"; then status=1
  elif [[ -n "$remaining" ]]; then
    status=1
    printf '%s\n' "$remaining" > "$EVIDENCE/cleanup-required-pids.txt"
    for pid in $remaining; do kill -TERM "$pid" 2>/dev/null || true; done
    while [[ -n "$(owned_pids)" && "$attempt" -lt 30 ]]; do sleep 0.1; attempt=$((attempt+1)); done
    remaining="$(owned_pids)"
    for pid in $remaining; do kill -KILL "$pid" 2>/dev/null || true; done
    sleep 0.1
  fi
  if [[ -n "$OPEN_PID" ]]; then kill -TERM "$OPEN_PID" 2>/dev/null || true; wait "$OPEN_PID" 2>/dev/null || true; fi
  if remaining="$(owned_pids)" && [[ -z "$remaining" ]]; then
    printf 'absent\n' > "$EVIDENCE/final-process-state.txt"
  else status=1; printf 'unconfirmed\n' > "$EVIDENCE/final-process-state.txt"; fi
  printf '%s\n' "$status" > "$EVIDENCE/runner-exit-status.txt"
  exit "$status"
}
trap 'finish "$?"' EXIT
trap 'finish 130' INT
trap 'finish 143' TERM
trap 'finish 129' HUP
git rev-parse HEAD > "$EVIDENCE/source-revision.txt"
git status --porcelain=v1 > "$EVIDENCE/source-status.txt"
git ls-files --cached --others --exclude-standard -z > "$EVIDENCE/source-files.nul"
xargs -0 shasum -a 256 < "$EVIDENCE/source-files.nul" > "$EVIDENCE/source-sha256.txt"
tar -czf "$EVIDENCE/source.tar.gz" --null -T "$EVIDENCE/source-files.nul"
sw_vers > "$EVIDENCE/macos-version.txt"
uname -m > "$EVIDENCE/architecture.txt"
"$JAVA_HOME/bin/java" -version > "$EVIDENCE/jdk-version.txt" 2>&1
while IFS= read -r name; do
  case "$name" in VAADIN_DESKTOP_*|VATORI_FILE_*|VATORI_TEST_*|VATORI_APPLICATION_RESOURCES) unset "$name" ;; esac
done < <(compgen -e)
EXTRA_OPEN_ARGS=()
if [[ "$PROFILE" == clipboard-contention ]]; then
  /usr/bin/swiftc "$ACCEPTANCE/Tests/clipboard-contention-writer.swift" -o "$EVIDENCE/clipboard-contender" > "$EVIDENCE/contender-build.log" 2>&1
  shasum -a 256 "$EVIDENCE/clipboard-contender" > "$EVIDENCE/contender-sha256.txt"
  EXTRA_OPEN_ARGS=(--env VATORI_TEST_CLIPBOARD_AUTHORIZED=1 --env "VATORI_TEST_CLIPBOARD_CONTENDER=$EVIDENCE/clipboard-contender")
fi
if [[ -n "$PREPARED_APP" ]]; then
  printf '%s\n' "$PREPARED_APP" > "$EVIDENCE/prepared-app-origin.txt"
  # APFS clones keep isolated writable files without duplicating bundle blocks.
  cp -cRp "$PREPARED_APP" "$APP"
else
  bash "$ROOT/bin/vaadin-desktop" package test-apps/flow-over-ipc-framework-app > "$EVIDENCE/package.log" 2>&1
  if [[ "$PROFILE" == default-deny ]]; then
    export VAADIN_DESKTOP_ACCEPTANCE_OMIT_CAPABILITY_MANIFEST=1
    export VAADIN_DESKTOP_ACCEPTANCE_CAPABILITY_MANIFEST_FALLBACK_MODE=manifest-enforced
  fi
  bash "$ACCEPTANCE/bin/build-host" "$ROOT" test-apps/flow-over-ipc-framework-app flow-ipc > "$EVIDENCE/build-host.log" 2>&1
  cp -cRp "$ROOT/.build/native-hosts/macos/VaadinDesktopHost.app" "$APP"
fi
shasum -a 256 -c "$EVIDENCE/source-sha256.txt" > "$EVIDENCE/source-check.log"
if [[ "$PROFILE" == default-deny ]]; then
  [[ "$(tr -d '\r\n' < "$APP/Contents/Resources/desktop-capabilities.json")" == '{"schemaVersion":1,"permissionMode":"manifest-enforced","windows":[]}' ]] || exit 1
fi
(cd "$EVIDENCE"; find Launched.app -type f -exec shasum -a 256 {} + > bundle-sha256.txt)
printf '%s\n' "N01/N02/N08/N09 profile=$PROFILE; standard production bundle; opaque Flow IPC. Browser navigation/observation and generated AppKit input; public window/panel operations, plus one test-only JVM fault in recovery profiles. Panel profiles only cancel/invalidate, never select a file. Only the explicitly authorized clipboard-contention profile mutates the clipboard; it uses a separate test writer, two rejected old-owner restore calls and one conditional verified recovery. No OS permission or file I/O; no physical/AT evidence. A reused app retains its original source provenance; source.tar.gz describes this invocation." > "$EVIDENCE/profile.txt"
open -n -W -o "$EVIDENCE/host.out.log" --stderr "$EVIDENCE/host.err.log" \
  "${EXTRA_OPEN_ARGS[@]}" \
  --env "JAVA_HOME=$JAVA_HOME" \
  --env "VAADIN_DESKTOP_FLOW_IPC_AUTO_$FLAG=1" \
  --env VAADIN_DESKTOP_FLOW_IPC_AUTO_SHUTDOWN=1 \
  --env "VAADIN_DESKTOP_FLOW_IPC_AUTO_SHUTDOWN_TIMEOUT_SECONDS=$TIMEOUT" \
  --env VAADIN_DESKTOP_FLOW_IPC_TRACE_DETAIL=full "$APP" &
OPEN_PID=$!
started=$SECONDS
while kill -0 "$OPEN_PID" 2>/dev/null; do
  if (( SECONDS - started > TIMEOUT + 30 )); then echo 'External capability deadline exceeded' >&2; exit 124; fi
  sleep 1
done
wait "$OPEN_PID"
OPEN_PID=""
bash "$ROOT/bin/flow-ipc-trace-inspect" "--require-flow-ipc-$GATE" \
  "$EVIDENCE/host.out.log" > "$EVIDENCE/verification.log" 2>&1
shasum -a 256 -c "$EVIDENCE/source-sha256.txt" > "$EVIDENCE/final-source-check.log"
echo "PASS: $EVIDENCE"
