#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
HOST_LOG="$ROOT/.build/native-hosts/macos/host.out.log"

export VAADIN_DESKTOP_MACOS_NO_ACTIVATE=0
export VAADIN_DESKTOP_MACOS_ACCEPTANCE_DIRECT_EXECUTION=1
export VAADIN_DESKTOP_FLOW_IPC_AUTO_DND=1
export VAADIN_DESKTOP_FLOW_IPC_DND_INPUT_MODE=appkit-event-queue-pointer
export VAADIN_DESKTOP_FLOW_IPC_AUTO_SHUTDOWN=1
export VAADIN_DESKTOP_FLOW_IPC_AUTO_SHUTDOWN_TIMEOUT_SECONDS=45

bash "$ROOT/test-support/native-host-macos-acceptance/bin/run" \
  dev test-apps/flow-over-ipc-framework-app

bash "$ROOT/bin/flow-ipc-trace-inspect" \
  --require-flow-ipc-flow-dnd \
  "$HOST_LOG"
