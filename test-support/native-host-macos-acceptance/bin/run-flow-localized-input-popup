bash "$ROOT/test-support/native-host-macos-acceptance/bin/run" dev test-apps/flow-over-ipc-framework-app

bash "$ROOT/bin/flow-ipc-trace-inspect" --require-flow-ipc-localized-input-popup "$HOST_LOG"
