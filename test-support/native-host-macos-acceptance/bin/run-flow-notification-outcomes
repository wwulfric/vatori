#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
ACCEPTANCE_ROOT="$ROOT/test-support/native-host-macos-acceptance"
BUILD_ROOT="$ROOT/.build/native-hosts/macos"
MODE="${1:-authorization-required}"
if [[ $# -gt 1 ]]; then
  echo "Usage: $0 [authorization-required|os-denied|scheduled|foreground-delivery]" >&2
  exit 2
fi
case "$MODE" in
  authorization-required) NO_ACTIVATE=1 ;;
  os-denied|scheduled|foreground-delivery) NO_ACTIVATE=0 ;;
  *) echo "Unknown notification outcome mode: $MODE" >&2; exit 2 ;;
esac
if [[ "$(uname -s)" != Darwin ]]; then
  echo "Native notification acceptance requires macOS." >&2
  exit 1
fi
TIMEOUT="${VAADIN_DESKTOP_FLOW_IPC_AUTO_SHUTDOWN_TIMEOUT_SECONDS:-180}"
if [[ ! "$TIMEOUT" =~ ^[1-9][0-9]*$ || ${#TIMEOUT} -gt 4 || "$TIMEOUT" -gt 3600 ]]; then
  echo "Notification acceptance timeout must be an integer from 1 to 3600 seconds." >&2
  exit 2
fi
if [[ -z "${JAVA_HOME:-}" || ! -x "$JAVA_HOME/bin/java" ]]; then
  echo "Set JAVA_HOME to a complete local JDK." >&2
  exit 2
fi
if [[ "${VATORI_NATIVE_HOST_MACOS_ACCEPTANCE_PACKAGE_LOCK_HELD:-}" != 1 ]]; then
  exec env VATORI_NATIVE_HOST_MACOS_ACCEPTANCE_PACKAGE_LOCK_HELD=1 \
    bash "$ACCEPTANCE_ROOT/bin/with-package-lock" -- bash "$0" "$@"
fi

HOST_LOG="$BUILD_ROOT/host-notification-$MODE.out.log"
HOST_ERR_LOG="$BUILD_ROOT/host-notification-$MODE.err.log"
mkdir -p "$BUILD_ROOT"
: > "$HOST_LOG"
: > "$HOST_ERR_LOG"
MANIFEST_NAME=notification-outcomes
DRIVER_FLAG=VAADIN_DESKTOP_FLOW_IPC_AUTO_NOTIFICATION_OUTCOMES
INSPECTOR_FLAG=--require-flow-ipc-notification-outcomes
if [[ "$MODE" == foreground-delivery ]]; then
  MANIFEST_NAME=notification-delivery
  DRIVER_FLAG=VAADIN_DESKTOP_FLOW_IPC_AUTO_NOTIFICATION_DELIVERY
  INSPECTOR_FLAG=--require-flow-ipc-notification-delivery
fi
export VAADIN_DESKTOP_ACCEPTANCE_CAPABILITY_MANIFEST="$ACCEPTANCE_ROOT/Fixtures/$MANIFEST_NAME-capabilities.json"
unset VAADIN_DESKTOP_ACCEPTANCE_OMIT_CAPABILITY_MANIFEST
bash "$ROOT/bin/vaadin-desktop" package test-apps/flow-over-ipc-framework-app
bash "$ACCEPTANCE_ROOT/bin/build-host" \
  "$ROOT" test-apps/flow-over-ipc-framework-app flow-ipc

umask 077
# Keep the signed app outside system temporary directories: macOS notification
# eligibility can depend on its location even after LaunchServices registration.
# This private generated leaf does not bypass or pre-grant OS authorization.
WORK="$(mktemp -d "$BUILD_ROOT/notification-outcomes.XXXXXX")"
HOST_APP="$WORK/VaadinDesktopHost.app"
HOST_EXE="$HOST_APP/Contents/MacOS/VaadinDesktopHost"
SIDECAR_JAR="$HOST_APP/Contents/Resources/Sidecar/application.jar"
BUNDLE_ID="dev.vatori.desktop.acceptance.notification.$MODE.$(uuidgen | tr '[:upper:]' '[:lower:]')"
OPEN_WAIT_PID=""

# Match only this owned clone and the sidecar JAR inside this clone. The JVM
# itself is the user's unchanged JDK and must never be terminated by broad name.
owned_pids() {
  local host_alias="${HOST_EXE#/private}"
  local jar_alias="${SIDECAR_JAR#/private}"
  local java_exe="$JAVA_HOME/bin/java"
  local java_alias="${java_exe#/private}"
  ps -axo pid=,command= | awk -v host="$HOST_EXE" -v host_alias="$host_alias" \
    -v jar="$SIDECAR_JAR" -v jar_alias="$jar_alias" \
    -v java="$java_exe" -v java_alias="$java_alias" '
    function owns_jar(command, path) {
      # JavaSidecarLaunchPlan supplies exactly ["-jar", application.jar].
      # A later -jar in another application arguments is not an owned JVM.
      return command == java " -jar " path || command == java_alias " -jar " path;
    }
    { pid=$1; $1=""; sub(/^ +/, "");
      if ($0 == host || $0 == host_alias ||
          owns_jar($0, jar) || owns_jar($0, jar_alias)) print pid; }
  '
}
cleanup() {
  # Signals enter this same cleanup function rather than exiting separately.
  # Even a pending signal at EXIT-handler entry must finish owned cleanup.
  trap '' HUP INT TERM
  local status="$1"
  trap - EXIT
  local remaining pid attempt=0
  if ! remaining="$(owned_pids)"; then
    echo "Cannot inspect owned notification processes; retaining clone: $WORK" >&2
    exit 1
  fi
  if [[ -n "$remaining" ]]; then
    status=1
    for pid in $remaining; do kill -TERM "$pid" 2>/dev/null || true; done
    while [[ -n "$remaining" && "$attempt" -lt 30 ]]; do
      sleep 0.1
      attempt=$((attempt + 1))
      if ! remaining="$(owned_pids)"; then
        echo "Cannot inspect owned notification processes; retaining clone: $WORK" >&2
        exit 1
      fi
    done
    if [[ -n "$remaining" ]]; then
      for pid in $remaining; do kill -KILL "$pid" 2>/dev/null || true; done
      sleep 0.1
    fi
  fi
  if [[ -n "$OPEN_WAIT_PID" ]]; then
    kill -TERM "$OPEN_WAIT_PID" 2>/dev/null || true
    wait "$OPEN_WAIT_PID" 2>/dev/null || true
  fi
  if ! remaining="$(owned_pids)"; then
    echo "Cannot inspect owned notification processes; retaining clone: $WORK" >&2
    exit 1
  fi
  if [[ -n "$remaining" ]]; then
    echo "Owned notification processes remain; retaining clone: $WORK" >&2
    exit 1
  fi
  # WORK is an exact mktemp-owned leaf, not a user app or shared build root.
  if [[ "${WORK%/*}" == "$BUILD_ROOT" \
      && "${WORK##*/}" =~ ^notification-outcomes\.[[:alnum:]]{6}$ \
      && -d "$WORK" && ! -L "$WORK" ]]; then
    rm -rf -- "$WORK"
  else
    echo "Refusing cleanup of unexpected clone path: $WORK" >&2
    status=1
  fi
  exit "$status"
}
trap 'cleanup "$?"' EXIT
trap 'cleanup 130' INT
trap 'cleanup 143' TERM
trap 'cleanup 129' HUP

ditto "$BUILD_ROOT/VaadinDesktopHost.app" "$HOST_APP"
plutil -replace CFBundleIdentifier -string "$BUNDLE_ID" "$HOST_APP/Contents/Info.plist"
plutil -replace CFBundleName -string "Vatori notification $MODE" "$HOST_APP/Contents/Info.plist"
codesign --force --sign - "$HOST_APP"
codesign --verify --strict --verbose=2 "$HOST_APP"
echo "Notification acceptance app: $HOST_APP"
echo "Fresh notification identity: $BUNDLE_ID"
echo "Expected public outcome: $MODE"
echo "Trace: $HOST_LOG"
if [[ "$MODE" == authorization-required ]]; then
  echo "No OS authorization prompt is expected or permitted in this mode."
elif [[ "$MODE" == os-denied ]]; then
  echo "External operator: choose Don't Allow in this new app's notification prompt."
else
  echo "External operator: choose Allow in this new app's notification prompt."
fi
echo "No existing application notification setting is reset or modified."
echo "SCHEDULED means accepted by the notification system, not visible delivery."
if [[ "$MODE" == foreground-delivery ]]; then
  echo "This run sends preparation and foreground-probe notifications after one Allow choice."
  echo "Watch for the system banner titled Vatori foreground probe; report separately whether it appeared."
  echo "The automated gate proves a matching Notification Center record, not banner visibility."
fi

for acceptance_flag in $(compgen -v VAADIN_DESKTOP_FLOW_IPC_AUTO_); do
  unset "$acceptance_flag"
done
unset VAADIN_DESKTOP_FLOW_IPC_STOP_INITIAL_NAVIGATION
open_args=(-n -W -o "$HOST_LOG" --stderr "$HOST_ERR_LOG")
# All stages require a frontmost/key window for generated native input. The
# host's no-activate setting suppresses the authorization prompt in required
# mode; a LaunchServices background launch is not part of that policy proof.
open "${open_args[@]}" \
  --env "JAVA_HOME=$JAVA_HOME" \
  --env "VAADIN_DESKTOP_MACOS_NO_ACTIVATE=$NO_ACTIVATE" \
  --env "$DRIVER_FLAG=1" \
  --env "VAADIN_DESKTOP_FLOW_IPC_NOTIFICATION_EXPECTED_OUTCOME=$MODE" \
  --env VAADIN_DESKTOP_FLOW_IPC_AUTO_SHUTDOWN=1 \
  --env "VAADIN_DESKTOP_FLOW_IPC_AUTO_SHUTDOWN_TIMEOUT_SECONDS=$TIMEOUT" \
  --env VAADIN_DESKTOP_FLOW_IPC_TRACE_DETAIL=full "$HOST_APP" &
OPEN_WAIT_PID=$!
run_started=$SECONDS
while kill -0 "$OPEN_WAIT_PID" 2>/dev/null; do
  if (( SECONDS - run_started > TIMEOUT + 30 )); then
    echo "Notification acceptance exceeded its external runtime deadline." >&2
    exit 124
  fi
  sleep 1
done
wait "$OPEN_WAIT_PID"
OPEN_WAIT_PID=""
bash "$ROOT/bin/flow-ipc-trace-inspect" \
  "$INSPECTOR_FLAG" "$HOST_LOG"
