#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
ACCEPTANCE="$ROOT/test-support/native-host-macos-acceptance"
[[ $# -ge 1 && $# -le 2 ]] || { echo "Usage: $0 delivery|recovery|in-flight|exhaustion [prepared-app]" >&2; exit 2; }
PROFILE="$1"
EXPECTED_LAUNCH_EXIT=0
case "$PROFILE" in
  delivery) FLAG=PUSH_DELIVERY; GATE=push-delivery; TIMEOUT=30 ;;
  recovery) FLAG=PUSH_RECOVERY; GATE=push-recovery; TIMEOUT=30 ;;
  in-flight) FLAG=IN_FLIGHT_REQUEST_RECOVERY; GATE=in-flight-request-recovery; TIMEOUT=60 ;;
  exhaustion) FLAG=SIDECAR_RECOVERY_EXHAUSTION; GATE=sidecar-recovery-exhaustion; TIMEOUT=60; EXPECTED_LAUNCH_EXIT=1 ;;
  *) echo "Unknown push baseline profile: $PROFILE" >&2; exit 2 ;;
esac
PREPARED_APP="${2:-}"
[[ -z "$PREPARED_APP" || ( "$PREPARED_APP" == /* && -d "$PREPARED_APP" ) ]] || exit 2
[[ "$(uname -s)" == Darwin && -x "${JAVA_HOME:?Set JAVA_HOME}/bin/java" ]]
if [[ "${VATORI_NATIVE_HOST_MACOS_ACCEPTANCE_PACKAGE_LOCK_HELD:-}" != 1 ]]; then
  exec env VATORI_NATIVE_HOST_MACOS_ACCEPTANCE_PACKAGE_LOCK_HELD=1 \
    bash "$ACCEPTANCE/bin/with-package-lock" -- bash "$0" "$@"
fi
cd "$ROOT"
umask 077
mkdir -p "$ROOT/.build/native-hosts/macos"
EVIDENCE="$(mktemp -d "$ROOT/.build/native-hosts/macos/push-$PROFILE-evidence.XXXXXX")"
APP="$EVIDENCE/Launched.app"
EXE="$APP/Contents/MacOS/VaadinDesktopHost"
JAR="$APP/Contents/Resources/Sidecar/application.jar"
OPEN_PID=""
echo "Evidence: $EVIDENCE"
owned_pids() {
  ps -axo pid=,command= | awk -v host="$EXE" -v jar="$JAR" -v java="$JAVA_HOME/bin/java" '
    {pid=$1; $1=""; sub(/^ +/, ""); if ($0 == host || $0 == java " -jar " jar) print pid;}'
}
finish() {
  local status="$1" remaining pid attempt=0
  trap - EXIT
  trap '' HUP INT TERM
  printf '%s\n' "$status" > "$EVIDENCE/primary-exit-status.txt"
  if ! remaining="$(owned_pids)"; then status=1
  elif [[ -n "$remaining" ]]; then
    status=1
    printf '%s\n' "$remaining" > "$EVIDENCE/cleanup-required-pids.txt"
    for pid in $remaining; do kill -TERM "$pid" 2>/dev/null || true; done
    while [[ -n "$(owned_pids)" && "$attempt" -lt 30 ]]; do sleep 0.1; attempt=$((attempt+1)); done
    remaining="$(owned_pids)"
    for pid in $remaining; do kill -KILL "$pid" 2>/dev/null || true; done
    sleep 0.1
  fi
  if [[ -n "$OPEN_PID" ]]; then kill -TERM "$OPEN_PID" 2>/dev/null || true; wait "$OPEN_PID" 2>/dev/null || true; fi
  if remaining="$(owned_pids)" && [[ -z "$remaining" ]]; then
    printf 'absent\n' > "$EVIDENCE/final-process-state.txt"
  else status=1; printf 'unconfirmed\n' > "$EVIDENCE/final-process-state.txt"; fi
  printf '%s\n' "$status" > "$EVIDENCE/runner-exit-status.txt"
  exit "$status"
}
trap 'finish "$?"' EXIT
trap 'finish 130' INT
trap 'finish 143' TERM
trap 'finish 129' HUP
git rev-parse HEAD > "$EVIDENCE/source-revision.txt"
git status --porcelain=v1 > "$EVIDENCE/source-status.txt"
git ls-files --cached --others --exclude-standard -z > "$EVIDENCE/source-files.nul"
xargs -0 shasum -a 256 < "$EVIDENCE/source-files.nul" > "$EVIDENCE/source-sha256.txt"
tar -czf "$EVIDENCE/source.tar.gz" --null -T "$EVIDENCE/source-files.nul"
sw_vers > "$EVIDENCE/macos-version.txt"
"$JAVA_HOME/bin/java" -version > "$EVIDENCE/jdk-version.txt" 2>&1
while IFS= read -r name; do
  case "$name" in VAADIN_DESKTOP_*|VATORI_FILE_*|VATORI_TEST_*|VATORI_APPLICATION_RESOURCES) unset "$name" ;; esac
done < <(compgen -e)
if [[ -n "$PREPARED_APP" ]]; then
  printf '%s\n' "$PREPARED_APP" > "$EVIDENCE/prepared-app-origin.txt"
  cp -cRp "$PREPARED_APP" "$APP"
else
  bash "$ROOT/bin/vaadin-desktop" package test-apps/flow-over-ipc-framework-app > "$EVIDENCE/package.log" 2>&1
  bash "$ACCEPTANCE/bin/build-host" "$ROOT" test-apps/flow-over-ipc-framework-app flow-ipc > "$EVIDENCE/build-host.log" 2>&1
  cp -cRp "$ROOT/.build/native-hosts/macos/VaadinDesktopHost.app" "$APP"
fi
shasum -a 256 -c "$EVIDENCE/source-sha256.txt" > "$EVIDENCE/source-check.log"
if [[ "$PROFILE" == exhaustion ]]; then
  # The existing exhaustion contract uses a two-attempt public manifest policy.
  # Change only this isolated copy, never the prepared app or product sources.
  cp "$APP/Contents/Resources/VatoriHost.json" "$EVIDENCE/original-VatoriHost.json"
  node - "$APP/Contents/Resources/VatoriHost.json" <<'JS'
const fs = require('fs'), file = process.argv[2];
const config = JSON.parse(fs.readFileSync(file, 'utf8'));
if (config.transport !== 'flow-ipc' || !config.recovery) throw new Error('Expected Flow IPC recovery policy');
config.recovery.restartLimit = 2;
config.recovery.stableRunSeconds = 30;
fs.writeFileSync(file, JSON.stringify(config, null, 2) + '\n');
JS
  codesign --force --sign - "$APP" > "$EVIDENCE/sign.log" 2>&1
  codesign --verify --strict "$APP" >> "$EVIDENCE/sign.log" 2>&1
fi
(cd "$EVIDENCE"; find Launched.app -type f -exec shasum -a 256 {} + > bundle-sha256.txt)
printf '%s\n' "R01/R04 profile=$PROFILE; standard production bundle; opaque Flow IPC. Browser-programmatic actions with test-only loss/gap or owned-JVM failure injection; real Java and official Flow client. Exhaustion changes only the copied recovery policy to two attempts and re-signs it. No clipboard, OS permission, file-panel, physical/AT evidence. A reused app retains its original source provenance; source.tar.gz describes this invocation." > "$EVIDENCE/profile.txt"
if [[ "$PROFILE" == exhaustion ]]; then
  # Direct execution retains the actual expected nonzero host exit status.
  VAADIN_DESKTOP_MACOS_NO_ACTIVATE=1 \
  VAADIN_DESKTOP_FLOW_IPC_AUTO_SIDECAR_RECOVERY_EXHAUSTION=1 \
  VAADIN_DESKTOP_FLOW_IPC_AUTO_SHUTDOWN=1 \
  VAADIN_DESKTOP_FLOW_IPC_AUTO_SHUTDOWN_TIMEOUT_SECONDS="$TIMEOUT" \
  VAADIN_DESKTOP_FLOW_IPC_TRACE_DETAIL=full \
    "$EXE" > "$EVIDENCE/host.out.log" 2> "$EVIDENCE/host.err.log" &
else
open -g -n -W -o "$EVIDENCE/host.out.log" --stderr "$EVIDENCE/host.err.log" \
  --env "JAVA_HOME=$JAVA_HOME" --env VAADIN_DESKTOP_MACOS_NO_ACTIVATE=1 \
  --env "VAADIN_DESKTOP_FLOW_IPC_AUTO_$FLAG=1" \
  --env VAADIN_DESKTOP_FLOW_IPC_AUTO_SHUTDOWN=1 \
  --env "VAADIN_DESKTOP_FLOW_IPC_AUTO_SHUTDOWN_TIMEOUT_SECONDS=$TIMEOUT" \
  --env VAADIN_DESKTOP_FLOW_IPC_TRACE_DETAIL=full "$APP" &
fi
OPEN_PID=$!
started=$SECONDS
while kill -0 "$OPEN_PID" 2>/dev/null; do
  if (( SECONDS - started > TIMEOUT + 30 )); then echo 'External push deadline exceeded' >&2; exit 124; fi
  sleep 1
done
set +e
wait "$OPEN_PID"
launch_status=$?
set -e
OPEN_PID=""
printf '%s\n' "$launch_status" > "$EVIDENCE/launch-exit-status.txt"
[[ "$launch_status" == "$EXPECTED_LAUNCH_EXIT" ]] || { echo "Unexpected launch exit: $launch_status" >&2; exit 1; }
bash "$ROOT/bin/flow-ipc-trace-inspect" "--require-flow-ipc-$GATE" \
  "$EVIDENCE/host.out.log" > "$EVIDENCE/verification.log" 2>&1
shasum -a 256 -c "$EVIDENCE/source-sha256.txt" > "$EVIDENCE/final-source-check.log"
(cd "$EVIDENCE"; shasum -a 256 -c bundle-sha256.txt > bundle-check.log)
echo "PASS: $EVIDENCE"
