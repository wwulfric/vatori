#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
ACCEPTANCE_ROOT="$ROOT/test-support/native-host-macos-acceptance"
HOST_LOG="$ROOT/.build/native-hosts/macos/host.out.log"
TRACE="$ROOT/.build/native-hosts/macos/host-navigation-timeout.out.log"

if [[ "${VATORI_NATIVE_HOST_MACOS_ACCEPTANCE_PACKAGE_LOCK_HELD:-}" != "1" ]]; then
  exec env VATORI_NATIVE_HOST_MACOS_ACCEPTANCE_PACKAGE_LOCK_HELD=1 \
    bash "$ACCEPTANCE_ROOT/bin/with-package-lock" -- bash "$0" "$@"
fi

# Fault injection belongs only to the explicit acceptance host. A real JVM
# sends ready and the normal host creates its WKWebView before loading stops.
export VAADIN_DESKTOP_FLOW_IPC_STOP_INITIAL_NAVIGATION=1
export VAADIN_DESKTOP_FLOW_IPC_AUTO_SHUTDOWN=1
export VAADIN_DESKTOP_FLOW_IPC_AUTO_SHUTDOWN_TIMEOUT_SECONDS=2
export VAADIN_DESKTOP_FLOW_IPC_TRACE_DETAIL=full
export VAADIN_DESKTOP_MACOS_NO_ACTIVATE=1

# A package/build failure must not reuse a previous successful negative trace.
mkdir -p "$(dirname "$HOST_LOG")"
: > "$HOST_LOG"
: > "$TRACE"
set +e
bash "$ACCEPTANCE_ROOT/bin/run" dev test-apps/flow-over-ipc-framework-app
status=$?
set -e
cp "$HOST_LOG" "$TRACE"
if [[ "$status" -ne 1 ]]; then
  echo "Expected failed navigation acceptance exit code 1, got $status" >&2
  exit 1
fi

bash "$ROOT/bin/flow-ipc-trace-inspect" \
  --require-flow-ipc-host-navigation-timeout "$TRACE"

echo "Acceptance initial-navigation timeout passed (not a successful Flow startup)."
