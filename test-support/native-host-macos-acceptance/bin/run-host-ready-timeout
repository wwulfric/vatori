#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
ACCEPTANCE_ROOT="$ROOT/test-support/native-host-macos-acceptance"
BUILD_ROOT="$ROOT/.build/native-hosts/macos"
if [[ $# -gt 1 || ( $# -eq 1 && "$1" != cooperative && "$1" != blocked ) ]]; then
  echo "Usage: $0 [cooperative|blocked]" >&2
  exit 2
fi
MODE="${1:-cooperative}"
if [[ "$(uname -s)" != Darwin ]]; then
  echo "Initial-ready timeout acceptance requires macOS." >&2
  exit 1
fi
if [[ -z "${JAVA_HOME:-}" || ! -x "$JAVA_HOME/bin/java" \
    || ! -x "$JAVA_HOME/bin/javac" || ! -x "$JAVA_HOME/bin/jar" ]]; then
  echo "Set JAVA_HOME to a complete local JDK." >&2
  exit 2
fi
command -v node >/dev/null
if [[ "${VATORI_NATIVE_HOST_MACOS_ACCEPTANCE_PACKAGE_LOCK_HELD:-}" != 1 ]]; then
  exec env VATORI_NATIVE_HOST_MACOS_ACCEPTANCE_PACKAGE_LOCK_HELD=1 \
    bash "$ACCEPTANCE_ROOT/bin/with-package-lock" -- bash "$0" "$@"
fi
unset VAADIN_DESKTOP_ACCEPTANCE_CAPABILITY_MANIFEST VAADIN_DESKTOP_ACCEPTANCE_OMIT_CAPABILITY_MANIFEST
unset VAADIN_DESKTOP_TEST_RECOVERY_TERMINATION_DIR
unset VAADIN_DESKTOP_TEST_HOST_SHUTDOWN_DIR VAADIN_DESKTOP_TEST_HOST_SHUTDOWN_MODE
unset VAADIN_DESKTOP_TEST_READY_TIMEOUT_DIR VAADIN_DESKTOP_TEST_READY_TIMEOUT_MODE
export VAADIN_DESKTOP_SIDECAR_INITIAL_READY_TIMEOUT_SECONDS=1
export VAADIN_DESKTOP_FLOW_IPC_SIDECAR_RESTART_LIMIT=0
HOST_LOG="$BUILD_ROOT/host-ready-timeout-$MODE.out.log"
HOST_ERR_LOG="$BUILD_ROOT/host-ready-timeout-$MODE.err.log"
umask 077
mkdir -p "$BUILD_ROOT"
: > "$HOST_LOG"
: > "$HOST_ERR_LOG"
VAADIN_DESKTOP_MAVEN_OFFLINE="${VAADIN_DESKTOP_MAVEN_OFFLINE:-1}" \
  bash "$ROOT/bin/vaadin-desktop" package test-apps/flow-over-ipc-framework-app

WORK="$(mktemp -d "$BUILD_ROOT/host-ready-timeout.XXXXXX")"
HOST_APP="$WORK/VaadinDesktopHost.app"
HOST_EXE="$HOST_APP/Contents/MacOS/VaadinDesktopHost"
SIDECAR_JAR="$HOST_APP/Contents/Resources/Sidecar/application.jar"
HOST_WAIT_PID=""
owned_pids() {
  ps -axo pid=,command= | awk -v host="$HOST_EXE" -v host_alias="${HOST_EXE#/private}" \
    -v jar="$SIDECAR_JAR" -v jar_alias="${SIDECAR_JAR#/private}" \
    -v java="$JAVA_HOME/bin/java" -v java_alias="${JAVA_HOME#/private}/bin/java" '
    function owns_jar(command, path) {
      return command == java " -jar " path || command == java_alias " -jar " path;
    }
    { pid=$1; $1=""; sub(/^ +/, "");
      if ($0 == host || $0 == host_alias || owns_jar($0, jar) || owns_jar($0, jar_alias)) print pid; }
  '
}
cleanup() {
  trap '' HUP INT TERM
  local status="$1"
  trap - EXIT
  local remaining pid attempt=0
  if ! remaining="$(owned_pids)"; then
    echo "Cannot inspect owned ready-timeout processes; retaining clone: $WORK" >&2
    exit 1
  fi
  if [[ -n "$remaining" ]]; then
    # Cleanup can only turn a run into failure, never rescue a successful gate.
    status=1
    for pid in $remaining; do kill -TERM "$pid" 2>/dev/null || true; done
    while [[ -n "$remaining" && "$attempt" -lt 30 ]]; do
      sleep 0.1
      attempt=$((attempt + 1))
      if ! remaining="$(owned_pids)"; then
        echo "Cannot inspect owned ready-timeout processes; retaining clone: $WORK" >&2
        exit 1
      fi
    done
    if [[ -n "$remaining" ]]; then
      for pid in $remaining; do kill -KILL "$pid" 2>/dev/null || true; done
      sleep 0.1
    fi
  fi
  if ! remaining="$(owned_pids)" || [[ -n "$remaining" ]]; then
    echo "Owned ready-timeout processes could not be confirmed stopped; retaining clone: $WORK" >&2
    exit 1
  fi
  if [[ -n "$HOST_WAIT_PID" ]]; then
    # A failed/missed signal must not turn cleanup into an unbounded wait.
    # The exact child is signalled only through the owned argv scan above;
    # signal-zero here only checks its independently captured identity.
    if ! node -e '
      const value = process.argv[1], pid = Number(value);
      if (!/^[1-9][0-9]*$/.test(value) || !Number.isSafeInteger(pid)) process.exit(1);
      try { process.kill(pid, 0); process.exit(1); }
      catch (error) { process.exit(error.code === "ESRCH" ? 0 : 1); }
    ' "$HOST_WAIT_PID"; then
      echo "Captured host PID could not be confirmed absent; retaining clone: $WORK" >&2
      exit 1
    fi
    # Reap only after ESRCH; EPERM and other lookup failures are not absence.
    wait "$HOST_WAIT_PID" 2>/dev/null || true
  fi
  if [[ "${WORK%/*}" == "$BUILD_ROOT" \
      && "${WORK##*/}" =~ ^host-ready-timeout\.[[:alnum:]]{6}$ \
      && -d "$WORK" && ! -L "$WORK" ]]; then
    rm -rf -- "$WORK"
  else
    echo "Refusing cleanup of unexpected clone path: $WORK" >&2
    status=1
  fi
  exit "$status"
}
trap 'cleanup "$?"' EXIT
trap 'cleanup 130' INT
trap 'cleanup 143' TERM
trap 'cleanup 129' HUP

STATE="$(mktemp -d "$WORK/vatori-ready-timeout.XXXXXX")"
FIXTURE_CLASSES="$WORK/fixture-classes"
mkdir "$FIXTURE_CLASSES"
"$JAVA_HOME/bin/javac" --release 21 -d "$FIXTURE_CLASSES" "$ACCEPTANCE_ROOT/Fixtures/NeverReadySidecar.java"
ditto "$BUILD_ROOT/VaadinDesktopHost.app" "$HOST_APP"
"$JAVA_HOME/bin/jar" cfe "$SIDECAR_JAR" NeverReadySidecar -C "$FIXTURE_CLASSES" .
plutil -replace CFBundleIdentifier -string \
  "dev.vatori.desktop.acceptance.readytimeout.$(uuidgen | tr '[:upper:]' '[:lower:]')" \
  "$HOST_APP/Contents/Info.plist"
plutil -replace CFBundleName -string "Vatori ready timeout $MODE" "$HOST_APP/Contents/Info.plist"
codesign --force --sign - "$HOST_APP"
codesign --verify --strict --verbose=2 "$HOST_APP"
echo "Initial-ready timeout clone: $HOST_APP"
echo "Private startup/hook markers: $STATE"
echo "Trace: $HOST_LOG"
echo "No-window negative probe: raw bundle executable preserves the exact fatal exit status; this is not GUI success evidence."
for acceptance_flag in $(compgen -v VAADIN_DESKTOP_FLOW_IPC_AUTO_); do unset "$acceptance_flag"; done
unset VAADIN_DESKTOP_FLOW_IPC_STOP_INITIAL_NAVIGATION
VAADIN_DESKTOP_TEST_READY_TIMEOUT_DIR="$STATE" \
VAADIN_DESKTOP_TEST_READY_TIMEOUT_MODE="$MODE" \
VAADIN_DESKTOP_MACOS_NO_ACTIVATE=1 \
VAADIN_DESKTOP_FLOW_IPC_TRACE_DETAIL=full \
  "$HOST_EXE" > "$HOST_LOG" 2> "$HOST_ERR_LOG" &
HOST_WAIT_PID=$!
HOST_PROCESS_IDENTIFIER="$HOST_WAIT_PID"
run_started=$SECONDS
while kill -0 "$HOST_WAIT_PID" 2>/dev/null; do
  if (( SECONDS - run_started > 20 )); then
    echo "Initial-ready timeout acceptance exceeded its external runtime deadline." >&2
    exit 124
  fi
  sleep 0.1
done
set +e
wait "$HOST_WAIT_PID"
status=$?
set -e
HOST_WAIT_PID=""
if [[ "$status" -ne 1 ]]; then
  echo "Expected host initial-ready timeout exit code 1, got $status" >&2
  exit 1
fi
# These independent checks happen before all cleanup, and never send a signal.
remaining="$(owned_pids)"
if [[ -n "$remaining" ]]; then
  echo "Owned host or JVM remains after fatal host exit; acceptance failed before cleanup." >&2
  exit 1
fi
node "$ACCEPTANCE_ROOT/Tests/host-ready-timeout-exit-evidence.mjs" \
  "$STATE" "$HOST_LOG" "$MODE" "$HOST_PROCESS_IDENTIFIER"
bash "$ROOT/bin/flow-ipc-trace-inspect" --require-flow-ipc-host-ready-timeout "$HOST_LOG"
echo "Host initial-ready timeout passed ($MODE; actual exit confirmed before cleanup)."
