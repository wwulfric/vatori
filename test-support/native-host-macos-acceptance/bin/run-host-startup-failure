#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
if [[ "${VATORI_NATIVE_HOST_MACOS_ACCEPTANCE_PACKAGE_LOCK_HELD:-}" != "1" ]]; then
  exec env VATORI_NATIVE_HOST_MACOS_ACCEPTANCE_PACKAGE_LOCK_HELD=1 \
    bash "$ROOT/test-support/native-host-macos-acceptance/bin/with-package-lock" -- \
    bash "$0" "$@"
fi
HOST_BUILD="$ROOT/.build/native-hosts/macos"
HOST_APP="$HOST_BUILD/VaadinDesktopHost.app"
HOST_EXE="$HOST_APP/Contents/MacOS/VaadinDesktopHost"
SIDECAR_JAR="$HOST_APP/Contents/Resources/Sidecar/application.jar"
TRACE="$HOST_BUILD/host-startup-failure.out.log"
ERROR_LOG="$HOST_BUILD/host-startup-failure.err.log"
BACKUP="$HOST_BUILD/host-startup-failure-sidecar.jar"

cleanup() {
  if [[ -f "$BACKUP" ]]; then
    mv "$BACKUP" "$SIDECAR_JAR"
  fi
}
trap cleanup EXIT

VAADIN_DESKTOP_MAVEN_OFFLINE="${VAADIN_DESKTOP_MAVEN_OFFLINE:-1}" \
  bash "$ROOT/bin/vaadin-desktop" package \
  test-apps/flow-over-ipc-framework-app

mv "$SIDECAR_JAR" "$BACKUP"
printf 'not a runnable jar\n' > "$SIDECAR_JAR"
: > "$TRACE"
: > "$ERROR_LOG"

set +e
VAADIN_DESKTOP_MACOS_NO_ACTIVATE=1 \
  "$HOST_EXE" > "$TRACE" 2> "$ERROR_LOG"
status=$?
set -e

if [[ "$status" -ne 1 ]]; then
  echo "Expected host startup failure exit code 1, got $status" >&2
  exit 1
fi

bash "$ROOT/bin/flow-ipc-trace-inspect" \
  --require-flow-ipc-host-startup-failure \
  "$TRACE"

echo "Host startup failure propagation passed."
