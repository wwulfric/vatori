#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
ACCEPTANCE="$ROOT/test-support/native-host-macos-acceptance"
[[ $# -ge 2 && $# -le 3 ]] || { echo "Usage: $0 shutdown|ready|fatal cooperative|blocked [prepared-app] (fatal: cooperative only, explicit file authorization required)" >&2; exit 2; }
PROFILE="$1"
MODE="$2"
[[ "$PROFILE" == shutdown || "$PROFILE" == ready || "$PROFILE" == fatal ]] || exit 2
[[ "$MODE" == cooperative || "$MODE" == blocked ]] || exit 2
if [[ "$PROFILE" == fatal ]]; then
  [[ "$MODE" == cooperative && "${VATORI_TEST_FATAL_FILE_AUTHORIZED:-}" == 1 ]] || {
    echo 'Fatal profile requires fresh authorization for one generated-file selection and VATORI_TEST_FATAL_FILE_AUTHORIZED=1.' >&2; exit 2;
  }
fi
PREPARED_APP="${3:-}"
[[ -z "$PREPARED_APP" || ( "$PREPARED_APP" == /* && -d "$PREPARED_APP" ) ]] || exit 2
[[ "$(uname -s)" == Darwin && -x "${JAVA_HOME:?Set JAVA_HOME}/bin/java" ]]
if [[ "${VATORI_NATIVE_HOST_MACOS_ACCEPTANCE_PACKAGE_LOCK_HELD:-}" != 1 ]]; then
  exec env VATORI_NATIVE_HOST_MACOS_ACCEPTANCE_PACKAGE_LOCK_HELD=1 \
    bash "$ACCEPTANCE/bin/with-package-lock" -- bash "$0" "$@"
fi
cd "$ROOT"
umask 077
mkdir -p "$ROOT/.build/native-hosts/macos"
EVIDENCE="$(mktemp -d "$ROOT/.build/native-hosts/macos/lifecycle-$PROFILE-$MODE-evidence.XXXXXX")"
APP="$EVIDENCE/Launched.app"
EXE="$APP/Contents/MacOS/VaadinDesktopHost"
JAR="$APP/Contents/Resources/Sidecar/application.jar"
OPEN_PID=""
WATCH_PID=""
echo "Evidence: $EVIDENCE"
owned_pids() {
  ps -axo pid=,command= | awk -v host="$EXE" -v jar="$JAR" -v java="$JAVA_HOME/bin/java" '
    {pid=$1; $1=""; sub(/^ +/, ""); if ($0 == host || $0 == java " -jar " jar) print pid;}'
}
finish() {
  local status="$1" remaining pid attempt=0
  trap - EXIT
  trap '' HUP INT TERM
  printf '%s\n' "$status" > "$EVIDENCE/primary-exit-status.txt"
  if [[ -n "$WATCH_PID" ]]; then kill -TERM "$WATCH_PID" 2>/dev/null || true; wait "$WATCH_PID" 2>/dev/null || true; fi
  if ! remaining="$(owned_pids)"; then status=1
  elif [[ -n "$remaining" ]]; then
    status=1
    printf '%s\n' "$remaining" > "$EVIDENCE/cleanup-required-pids.txt"
    for pid in $remaining; do kill -TERM "$pid" 2>/dev/null || true; done
    while [[ -n "$(owned_pids)" && "$attempt" -lt 30 ]]; do sleep 0.1; attempt=$((attempt+1)); done
    remaining="$(owned_pids)"
    for pid in $remaining; do kill -KILL "$pid" 2>/dev/null || true; done
    sleep 0.1
  fi
  if [[ -n "$OPEN_PID" ]]; then kill -TERM "$OPEN_PID" 2>/dev/null || true; wait "$OPEN_PID" 2>/dev/null || true; fi
  if remaining="$(owned_pids)" && [[ -z "$remaining" ]]; then
    printf 'absent\n' > "$EVIDENCE/final-process-state.txt"
  else status=1; printf 'unconfirmed\n' > "$EVIDENCE/final-process-state.txt"; fi
  printf '%s\n' "$status" > "$EVIDENCE/runner-exit-status.txt"
  exit "$status"
}
trap 'finish "$?"' EXIT
trap 'finish 130' INT
trap 'finish 143' TERM
trap 'finish 129' HUP
git rev-parse HEAD > "$EVIDENCE/source-revision.txt"
git status --porcelain=v1 > "$EVIDENCE/source-status.txt"
git ls-files --cached --others --exclude-standard -z > "$EVIDENCE/source-files.nul"
xargs -0 shasum -a 256 < "$EVIDENCE/source-files.nul" > "$EVIDENCE/source-sha256.txt"
tar -czf "$EVIDENCE/source.tar.gz" --null -T "$EVIDENCE/source-files.nul"
sw_vers > "$EVIDENCE/macos-version.txt"
"$JAVA_HOME/bin/java" -version > "$EVIDENCE/jdk-version.txt" 2>&1
while IFS= read -r name; do
  case "$name" in VAADIN_DESKTOP_*|VATORI_FILE_*|VATORI_TEST_*|VATORI_APPLICATION_RESOURCES) unset "$name" ;; esac
done < <(compgen -e)
if [[ -n "$PREPARED_APP" ]]; then
  printf '%s\n' "$PREPARED_APP" > "$EVIDENCE/prepared-app-origin.txt"
  cp -cRp "$PREPARED_APP" "$APP"
else
  bash "$ROOT/bin/vaadin-desktop" package test-apps/flow-over-ipc-framework-app > "$EVIDENCE/package.log" 2>&1
  bash "$ACCEPTANCE/bin/build-host" "$ROOT" test-apps/flow-over-ipc-framework-app flow-ipc > "$EVIDENCE/build-host.log" 2>&1
  cp -cRp "$ROOT/.build/native-hosts/macos/VaadinDesktopHost.app" "$APP"
fi
shasum -a 256 -c "$EVIDENCE/source-sha256.txt" > "$EVIDENCE/source-check.log"
case "$PROFILE" in
  ready) STATE_PREFIX=ready-timeout ;;
  shutdown) STATE_PREFIX=host-shutdown ;;
  fatal) STATE_PREFIX=fatal-protocol ;;
esac
STATE="$(mktemp -d "$EVIDENCE/vatori-$STATE_PREFIX.XXXXXX")"
node - "$APP/Contents/Resources/VatoriHost.json" "$PROFILE" <<'JS'
const fs=require('fs'),[file,profile]=process.argv.slice(2),config=JSON.parse(fs.readFileSync(file,'utf8'));
config.recovery.restartLimit=0;
if(profile==='ready')config.sidecarStartup.readyTimeoutSeconds=1;
else config.capabilityManifest='desktop-capabilities.json';
fs.writeFileSync(file,JSON.stringify(config,null,2)+'\n');
JS
if [[ "$PROFILE" == ready ]]; then
  mkdir "$EVIDENCE/fixture-classes"
  "$JAVA_HOME/bin/javac" --release 21 -d "$EVIDENCE/fixture-classes" "$ACCEPTANCE/Fixtures/NeverReadySidecar.java"
  "$JAVA_HOME/bin/jar" cfe "$JAR" NeverReadySidecar -C "$EVIDENCE/fixture-classes" .
  cp "$ACCEPTANCE/Tests/host-ready-timeout-exit-evidence.mjs" "$EVIDENCE/exit-verify.mjs"
elif [[ "$PROFILE" == shutdown ]]; then
  cp "$ACCEPTANCE/Fixtures/host-shutdown-termination-capabilities.json" "$APP/Contents/Resources/desktop-capabilities.json"
  cp "$ACCEPTANCE/Tests/host-shutdown-exit-evidence.mjs" "$EVIDENCE/exit-verify.mjs"
else
  cp "$ACCEPTANCE/Fixtures/file-read-grant-fatal-capabilities.json" "$APP/Contents/Resources/desktop-capabilities.json"
  cp "$ACCEPTANCE/Tests/file-read-grant-fatal-evidence.mjs" "$EVIDENCE/exit-verify.mjs"
  mkdir "$EVIDENCE/files"
  plutil -replace CFBundleName -string 'Vatori file grant fatal shutdown' "$APP/Contents/Info.plist"
fi
plutil -replace CFBundleIdentifier -string "dev.vatori.desktop.acceptance.lifecycle.$(uuidgen | tr '[:upper:]' '[:lower:]')" "$APP/Contents/Info.plist"
codesign --force --sign - "$APP"
codesign --verify --strict "$APP"
(cd "$EVIDENCE"; find Launched.app -type f -exec shasum -a 256 {} + > bundle-sha256.txt)
printf '%s\n' "R03 profile=$PROFILE mode=$MODE. Ready uses a never-ready test JVM without a window; shutdown/fatal use production Flow/WKWebView and generated AppKit input. Fatal additionally requires one authorized system Open-panel selection of a generated 48-byte file, then tests unsupported-version failure with an idle grant. Not physical input, Sandbox or in-flight I/O evidence. Reused bundle provenance remains at prepared-app-origin.txt." > "$EVIDENCE/profile.txt"
if [[ "$PROFILE" == fatal ]]; then
  echo "Prepared; waiting for $EVIDENCE/start before launching. Fixture root: $EVIDENCE/files"
  started=$SECONDS
  while [[ ! -f "$EVIDENCE/start" ]]; do
    if (( SECONDS - started > 300 )); then echo 'Start handoff expired' >&2; exit 124; fi
    sleep 0.2
  done
  : > "$EVIDENCE/host.out.log"
  : > "$EVIDENCE/host.err.log"
fi
if [[ "$PROFILE" == ready ]]; then
  VAADIN_DESKTOP_TEST_READY_TIMEOUT_DIR="$STATE" VAADIN_DESKTOP_TEST_READY_TIMEOUT_MODE="$MODE" \
    VAADIN_DESKTOP_MACOS_NO_ACTIVATE=1 VAADIN_DESKTOP_FLOW_IPC_TRACE_DETAIL=full \
    "$EXE" > "$EVIDENCE/host.out.log" 2> "$EVIDENCE/host.err.log" &
elif [[ "$PROFILE" == shutdown ]]; then
  open -n -W -o "$EVIDENCE/host.out.log" --stderr "$EVIDENCE/host.err.log" \
    --env "JAVA_HOME=$JAVA_HOME" \
    --env "VAADIN_DESKTOP_TEST_HOST_SHUTDOWN_DIR=$STATE" \
    --env "VAADIN_DESKTOP_TEST_HOST_SHUTDOWN_MODE=$MODE" \
    --env VAADIN_DESKTOP_MACOS_NO_ACTIVATE=0 \
    --env VAADIN_DESKTOP_FLOW_IPC_AUTO_HOST_SHUTDOWN_TERMINATION=1 \
    --env VAADIN_DESKTOP_FLOW_IPC_AUTO_SHUTDOWN=1 \
    --env VAADIN_DESKTOP_FLOW_IPC_AUTO_SHUTDOWN_TIMEOUT_SECONDS=90 \
    --env VAADIN_DESKTOP_FLOW_IPC_TRACE_DETAIL=full "$APP" &
else
  open -n -W -o "$EVIDENCE/host.out.log" --stderr "$EVIDENCE/host.err.log" \
    --env "JAVA_HOME=$JAVA_HOME" \
    --env "VAADIN_DESKTOP_TEST_FATAL_PROTOCOL_DIR=$STATE" \
    --env "VAADIN_DESKTOP_FLOW_IPC_FILE_READ_GRANT_FIXTURE_ROOT=$EVIDENCE/files" \
    --env VAADIN_DESKTOP_MACOS_NO_ACTIVATE=0 \
    --env VAADIN_DESKTOP_FLOW_IPC_AUTO_FILE_READ_GRANT_HOST_SHUTDOWN=1 \
    --env VAADIN_DESKTOP_FLOW_IPC_AUTO_SHUTDOWN=1 \
    --env VAADIN_DESKTOP_FLOW_IPC_AUTO_SHUTDOWN_TIMEOUT_SECONDS=210 \
    --env VAADIN_DESKTOP_FLOW_IPC_TRACE_DETAIL=full "$APP" &
fi
OPEN_PID=$!
HOST_PID="$OPEN_PID"
if [[ "$PROFILE" == fatal ]]; then
  node "$EVIDENCE/exit-verify.mjs" watch "$STATE" "$EVIDENCE/host.out.log" > "$EVIDENCE/watch-verification.log" 2>&1 &
  WATCH_PID=$!
  wait "$WATCH_PID"
  WATCH_PID=""
fi
started=$SECONDS
deadline=120
[[ "$PROFILE" == ready ]] && deadline=20
[[ "$PROFILE" == fatal ]] && deadline=30
while kill -0 "$OPEN_PID" 2>/dev/null; do
  if (( SECONDS - started > deadline )); then echo 'External lifecycle deadline exceeded' >&2; exit 124; fi
  sleep 0.1
done
set +e
wait "$OPEN_PID"
host_status=$?
set -e
OPEN_PID=""
printf '%s\n' "$host_status" > "$EVIDENCE/launch-exit-status.txt"
[[ -z "$(owned_pids)" ]] || { echo 'Owned processes remain before verification' >&2; exit 1; }
if [[ "$PROFILE" == ready ]]; then
  [[ "$host_status" == 1 ]] || exit 1
  node "$EVIDENCE/exit-verify.mjs" "$STATE" "$EVIDENCE/host.out.log" "$MODE" "$HOST_PID" > "$EVIDENCE/process-verification.log"
  GATE=host-ready-timeout
elif [[ "$PROFILE" == shutdown ]]; then
  [[ "$host_status" == 0 ]] || exit 1
  node "$EVIDENCE/exit-verify.mjs" "$STATE" "$EVIDENCE/host.out.log" "$MODE" > "$EVIDENCE/process-verification.log"
  GATE=host-shutdown-termination
else
  [[ "$host_status" == 0 || "$host_status" == 1 ]] || exit 1
  node "$EVIDENCE/exit-verify.mjs" verify "$STATE" "$EVIDENCE/host.out.log" > "$EVIDENCE/process-verification.log"
  GATE=file-read-grant-fatal-shutdown
fi
bash "$ROOT/bin/flow-ipc-trace-inspect" "--require-flow-ipc-$GATE" "$EVIDENCE/host.out.log" > "$EVIDENCE/verification.log" 2>&1
shasum -a 256 -c "$EVIDENCE/source-sha256.txt" > "$EVIDENCE/final-source-check.log"
echo "PASS: $EVIDENCE"
