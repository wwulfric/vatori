#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
MODULE="test-apps/flow-over-ipc-framework-app"
APPLICATION_DIRECTORY="$ROOT/$MODULE"
PROBE_FILE="$ROOT/test-apps/flow-over-ipc-framework-shared/pom.xml"
PROFILE_SOURCE_FILE="$ROOT/test-apps/flow-over-ipc-profile-shared/effective-sources/java/dev/vatori/ipcframework/profileshared/EffectiveMavenProfileValue.java"
PROFILE_RESOURCE_FILE="$ROOT/test-apps/flow-over-ipc-profile-shared/effective-resources/main/vatori-effective-maven-profile.txt"
HOST_LOG="$ROOT/.build/native-hosts/macos/host.out.log"
mkdir -p "$ROOT/.build"
PROBE_BACKUP="$(mktemp "$ROOT/.build/reactor-reload-probe.XXXXXX")"
SOURCE_BACKUP="$(mktemp "$ROOT/.build/effective-maven-source.XXXXXX")"
RESOURCE_BACKUP="$(mktemp "$ROOT/.build/effective-maven-resource.XXXXXX")"

cp "$PROBE_FILE" "$PROBE_BACKUP"
cp "$PROFILE_SOURCE_FILE" "$SOURCE_BACKUP"
cp "$PROFILE_RESOURCE_FILE" "$RESOURCE_BACKUP"
restore_probe() {
  cp "$PROBE_BACKUP" "$PROBE_FILE"
  cp "$SOURCE_BACKUP" "$PROFILE_SOURCE_FILE"
  cp "$RESOURCE_BACKUP" "$PROFILE_RESOURCE_FILE"
  rm -f "$PROBE_BACKUP" "$SOURCE_BACKUP" "$RESOURCE_BACKUP"
}
trap restore_probe EXIT

export VAADIN_DESKTOP_MAVEN_OFFLINE="${VAADIN_DESKTOP_MAVEN_OFFLINE:-1}"
export MAVEN_EXECUTABLE="${MAVEN_EXECUTABLE:-mvn}"
export MAVEN_REPO="${MAVEN_REPO:-$ROOT/.m2/repository}"
export VAADIN_DESKTOP_MACOS_HOST_BUILDER="$ROOT/test-support/native-host-macos-acceptance/bin/build-host-for-cli"
export VAADIN_DESKTOP_ACCEPTANCE_REPO_ROOT="$ROOT"
export VAADIN_DESKTOP_MACOS_NO_ACTIVATE="${VAADIN_DESKTOP_MACOS_NO_ACTIVATE:-1}"
export VAADIN_DESKTOP_FLOW_IPC_AUTO_SHUTDOWN=1
export VAADIN_DESKTOP_FLOW_IPC_AUTO_REACTOR_RELOAD=1
export VAADIN_DESKTOP_FLOW_IPC_AUTO_SHUTDOWN_TIMEOUT_SECONDS="${VAADIN_DESKTOP_FLOW_IPC_AUTO_SHUTDOWN_TIMEOUT_SECONDS:-180}"
export VAADIN_DESKTOP_REACTOR_RELOAD_PROBE_FILE="$PROBE_FILE"
export VAADIN_DESKTOP_REACTOR_RELOAD_APPLICATION_DIRECTORY="$APPLICATION_DIRECTORY"
export VAADIN_DESKTOP_EFFECTIVE_MAVEN_SOURCE_FILE="$PROFILE_SOURCE_FILE"
export VAADIN_DESKTOP_EFFECTIVE_MAVEN_RESOURCE_FILE="$PROFILE_RESOURCE_FILE"
export MAVEN_ARGS="${MAVEN_ARGS:+$MAVEN_ARGS }-Pflow-ipc-effective-maven-model-acceptance"

bash "$ROOT/bin/vaadin-desktop" dev-vite "$MODULE"
bash "$ROOT/bin/flow-ipc-trace-inspect" \
  --require-flow-ipc-reactor-reload-development \
  "$HOST_LOG"
