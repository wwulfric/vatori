#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
ACCEPTANCE_ROOT="$ROOT/test-support/native-host-macos-acceptance"
BUILD_ROOT="$ROOT/.build/native-hosts/macos"
if [[ $# -ne 0 ]]; then
  echo "Usage: $0" >&2
  exit 2
fi
if [[ "$(uname -s)" != Darwin ]]; then
  echo "Recovery termination acceptance requires macOS." >&2
  exit 1
fi
if [[ -z "${JAVA_HOME:-}" || ! -x "$JAVA_HOME/bin/java" ]]; then
  echo "Set JAVA_HOME to a complete local JDK." >&2
  exit 2
fi
if [[ "${VATORI_NATIVE_HOST_MACOS_ACCEPTANCE_PACKAGE_LOCK_HELD:-}" != 1 ]]; then
  exec env VATORI_NATIVE_HOST_MACOS_ACCEPTANCE_PACKAGE_LOCK_HELD=1 \
    bash "$ACCEPTANCE_ROOT/bin/with-package-lock" -- bash "$0" "$@"
fi
export VAADIN_DESKTOP_FLOW_IPC_SIDECAR_RESTART_LIMIT=2
export VAADIN_DESKTOP_FLOW_IPC_SIDECAR_RECOVERY_READY_TIMEOUT_SECONDS=15
export VAADIN_DESKTOP_FLOW_IPC_SIDECAR_RECOVERY_STABLE_RUN_SECONDS=30
unset VAADIN_DESKTOP_ACCEPTANCE_CAPABILITY_MANIFEST
unset VAADIN_DESKTOP_ACCEPTANCE_OMIT_CAPABILITY_MANIFEST
HOST_LOG="$BUILD_ROOT/host-recovery-termination.out.log"
HOST_ERR_LOG="$BUILD_ROOT/host-recovery-termination.err.log"
mkdir -p "$BUILD_ROOT"
: > "$HOST_LOG"
: > "$HOST_ERR_LOG"
bash "$ROOT/bin/vaadin-desktop" package test-apps/flow-over-ipc-framework-app
bash "$ACCEPTANCE_ROOT/bin/build-host" "$ROOT" test-apps/flow-over-ipc-framework-app flow-ipc

umask 077
WORK="$(mktemp -d "$BUILD_ROOT/recovery-termination.XXXXXX")"
HOST_APP="$WORK/VaadinDesktopHost.app"
HOST_EXE="$HOST_APP/Contents/MacOS/VaadinDesktopHost"
SIDECAR_JAR="$HOST_APP/Contents/Resources/Sidecar/application.jar"
OPEN_WAIT_PID=""

# The production launch plan has exactly two JVM arguments. Never match a later
# '-jar' in an unrelated application's arguments or a process name alone.
owned_pids() {
  ps -axo pid=,command= | awk -v host="$HOST_EXE" -v host_alias="${HOST_EXE#/private}" \
    -v jar="$SIDECAR_JAR" -v jar_alias="${SIDECAR_JAR#/private}" \
    -v java="$JAVA_HOME/bin/java" -v java_alias="${JAVA_HOME#/private}/bin/java" '
    function owns_jar(command, path) {
      return command == java " -jar " path || command == java_alias " -jar " path;
    }
    { pid=$1; $1=""; sub(/^ +/, "");
      if ($0 == host || $0 == host_alias || owns_jar($0, jar) || owns_jar($0, jar_alias)) print pid; }
  '
}
cleanup() {
  trap '' HUP INT TERM
  local status="$1"
  trap - EXIT
  local remaining pid attempt=0
  if ! remaining="$(owned_pids)"; then
    echo "Cannot inspect owned recovery processes; retaining clone: $WORK" >&2
    exit 1
  fi
  if [[ -n "$remaining" ]]; then
    status=1
    for pid in $remaining; do kill -TERM "$pid" 2>/dev/null || true; done
    while [[ -n "$remaining" && "$attempt" -lt 30 ]]; do
      sleep 0.1
      attempt=$((attempt + 1))
      if ! remaining="$(owned_pids)"; then
        echo "Cannot inspect owned recovery processes; retaining clone: $WORK" >&2
        exit 1
      fi
    done
    if [[ -n "$remaining" ]]; then
      for pid in $remaining; do kill -KILL "$pid" 2>/dev/null || true; done
      sleep 0.1
    fi
  fi
  if [[ -n "$OPEN_WAIT_PID" ]]; then
    kill -TERM "$OPEN_WAIT_PID" 2>/dev/null || true
    wait "$OPEN_WAIT_PID" 2>/dev/null || true
  fi
  if ! remaining="$(owned_pids)" || [[ -n "$remaining" ]]; then
    echo "Owned recovery processes could not be confirmed stopped; retaining clone: $WORK" >&2
    exit 1
  fi
  # Only this mktemp-owned leaf is disposable. Trace files remain outside it.
  if [[ "${WORK%/*}" == "$BUILD_ROOT" \
      && "${WORK##*/}" =~ ^recovery-termination\.[[:alnum:]]{6}$ \
      && -d "$WORK" && ! -L "$WORK" ]]; then
    rm -rf -- "$WORK"
  else
    echo "Refusing cleanup of unexpected clone path: $WORK" >&2
    status=1
  fi
  exit "$status"
}
trap 'cleanup "$?"' EXIT
trap 'cleanup 130' INT
trap 'cleanup 143' TERM
trap 'cleanup 129' HUP

STATE="$(mktemp -d "$WORK/vatori-recovery-termination.XXXXXX")"
ditto "$BUILD_ROOT/VaadinDesktopHost.app" "$HOST_APP"
plutil -replace CFBundleIdentifier -string \
  "dev.vatori.desktop.acceptance.recovery.$(uuidgen | tr '[:upper:]' '[:lower:]')" \
  "$HOST_APP/Contents/Info.plist"
plutil -replace CFBundleName -string "Vatori recovery termination" "$HOST_APP/Contents/Info.plist"
codesign --force --sign - "$HOST_APP"
codesign --verify --strict --verbose=2 "$HOST_APP"
echo "Recovery acceptance clone: $HOST_APP"
echo "Private three-generation test state: $STATE"
echo "Trace: $HOST_LOG"
echo "Only this clone's test sidecars are fault-injected; no notification or OS permission action is used."
for acceptance_flag in $(compgen -v VAADIN_DESKTOP_FLOW_IPC_AUTO_); do
  unset "$acceptance_flag"
done
unset VAADIN_DESKTOP_FLOW_IPC_STOP_INITIAL_NAVIGATION
open -n -W -o "$HOST_LOG" --stderr "$HOST_ERR_LOG" \
  --env "JAVA_HOME=$JAVA_HOME" \
  --env "VAADIN_DESKTOP_TEST_RECOVERY_TERMINATION_DIR=$STATE" \
  --env VAADIN_DESKTOP_MACOS_NO_ACTIVATE=0 \
  --env VAADIN_DESKTOP_FLOW_IPC_AUTO_RECOVERY_TERMINATION=1 \
  --env VAADIN_DESKTOP_FLOW_IPC_AUTO_SHUTDOWN=1 \
  --env VAADIN_DESKTOP_FLOW_IPC_AUTO_SHUTDOWN_TIMEOUT_SECONDS=120 \
  --env VAADIN_DESKTOP_FLOW_IPC_TRACE_DETAIL=full "$HOST_APP" &
OPEN_WAIT_PID=$!
run_started=$SECONDS
while kill -0 "$OPEN_WAIT_PID" 2>/dev/null; do
  if (( SECONDS - run_started > 150 )); then
    echo "Recovery acceptance exceeded its external runtime deadline." >&2
    exit 124
  fi
  sleep 1
done
wait "$OPEN_WAIT_PID"
OPEN_WAIT_PID=""
bash "$ROOT/bin/flow-ipc-trace-inspect" \
  --require-flow-ipc-recovery-termination "$HOST_LOG"
